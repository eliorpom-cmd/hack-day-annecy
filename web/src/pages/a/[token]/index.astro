---
// Call page opened from the link in the WhatsApp/SMS message. Public: the secret token is the key.
// Layout and values: DESIGN.md (« Page d'un appel »), texts: COPY.md. Markup: components/CallDetail.astro.
import Base from "../../../layouts/Base.astro";
import CallDetail from "../../../components/CallDetail.astro";
import { callPageByToken, capitalize } from "../../../lib/callpage";

const token = Astro.params.token ?? "";
const call = await callPageByToken(token);
if (!call) return new Response("Ce lien ne correspond à aucun appel.", { status: 404 });

const title = capitalize(call.subject ?? call.need ?? call.summary ?? "Appel");
const name = call.name ?? "Client";
---
<Base title={`${name}, ${title}`}>
  <CallDetail call={call} token={token} />
</Base>
