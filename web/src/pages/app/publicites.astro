---
// « Publicités »: ad drafts written from the business (Google search, Facebook/Instagram), budget, launch « Bientôt ».
// Pitch: ads bring calls, the répondeur takes them. Layout: DESIGN.md, texts: COPY.md.
import AppShell from "../../layouts/AppShell.astro";
import HubIcon from "../../components/hub/HubIcon.astro";
import SoonRow from "../../components/hub/SoonRow.astro";
import GooglePreview from "../../components/ads/GooglePreview.astro";
import MetaPreview from "../../components/ads/MetaPreview.astro";
import BudgetSlider from "../../components/ads/BudgetSlider.astro";
import { googleCopyText, metaCopyText } from "../../lib/ads";
import { adTargets, latestDrafts, type AdsBusiness } from "../../lib/ads-run";

const business = Astro.locals.business as unknown as AdsBusiness | null;
if (!business) return Astro.redirect("/onboarding");
const [{ google, meta }, { phone, siteUrl }] = await Promise.all([latestDrafts(business.id), adTargets(business)]);
const none = !google && !meta;
const trade = business.trade.trim().toLowerCase();
const city = business.city.trim();
const searchLine = trade && city ? `L’annonce s’affiche quand on cherche un ${trade} à ${city}.` : "L’annonce s’affiche quand on cherche votre métier près de chez vous.";
const nb = " ";
---
<AppShell title="Publicités" active="pubs">
  <main class="mx-auto flex min-h-dvh max-w-[480px] flex-col gap-6 px-4 pt-4 pb-8 lg:max-w-[1040px] lg:px-8 lg:pt-10">
    <a href="/app/visibilite" class="-mb-4 flex items-center gap-1 font-bold text-ink lg:hidden" style="min-height:48px"><HubIcon name="chevron-left" />Visibilité</a>
    <div>
      <h1 class="text-title font-bold">Publicités</h1>
      <p class="mt-2 text-muted">Les annonces font appeler. Le répondeur prend chaque appel.</p>
    </div>

    {none && (
      <div class="flex flex-col gap-2 lg:max-w-[420px]">
        <button type="button" class="btn btn-primary w-full" data-ads-generate="google meta"><HubIcon name="megaphone" /><span data-label>Écrire mes annonces</span></button>
        <p class="text-small text-muted">Écrites à partir de votre métier, de votre ville et de votre documentation.</p>
        <p class="hidden text-small font-bold text-ink" data-ads-error role="alert"></p>
      </div>
    )}

    <div class="grid gap-6 lg:grid-cols-2">
      {["google", "meta"].map((channel) => {
        const isGoogle = channel === "google";
        const draft = isGoogle ? google : meta;
        return (
          <section class="flex flex-col gap-[10px]" data-ads-section={channel}>
            <div>
              <h2 class="font-bold">{isGoogle ? `Google${nb}: quand on vous cherche` : `Facebook et Instagram${nb}: dans votre ville`}</h2>
              <p class="mt-0.5 text-small text-muted">{isGoogle ? searchLine : "L’annonce s’affiche aux habitants de votre secteur."}</p>
            </div>
            <div class="panel">
              <div class="p-[14px] pb-3">
                {draft ? (
                  isGoogle ? <GooglePreview draft={google!} name={business.name} phone={phone.display} siteUrl={siteUrl} />
                           : <MetaPreview draft={meta!} name={business.name} phone={phone.display} />
                ) : (
                  <div class="grid min-h-[160px] place-items-center rounded-call bg-page px-4 text-center text-small text-muted shadow-[inset_0_0_0_1px_var(--color-line)]">
                    L’annonce s’affichera ici.
                  </div>
                )}
              </div>

              {isGoogle && google && (
                <div class="row flex-col items-stretch gap-2">
                  <p class="text-small text-muted">Recherches visées · <b class="text-ink">{google.keywords.length}</b></p>
                  <ul class="flex flex-wrap gap-1.5">
                    {google.keywords.map((k) => <li class="kw">{k}</li>)}
                  </ul>
                </div>
              )}
              {!isGoogle && meta && (
                <div class="row">
                  <span class="icon-tile"><HubIcon name="map" size={18} class="text-ink" /></span>
                  <div class="min-w-0 flex-1"><p class="text-small text-muted">Zone</p><p>{meta.zone}</p></div>
                </div>
              )}

              <div class="row">
                <span class="icon-tile"><HubIcon name="phone" size={18} class="text-ink" /></span>
                <div class="min-w-0 flex-1">
                  <p class="text-small text-muted">Les appels arrivent sur</p>
                  {phone.display
                    ? <p><b>{phone.display}</b><span class="text-muted"> · {phone.answering ? "votre répondeur" : "votre portable"}</span></p>
                    : <p>Aucun numéro. <a href="/app/reglages" class="font-bold underline">Choisir un numéro</a></p>}
                </div>
              </div>
              {isGoogle && (
                <div class="row">
                  <span class="icon-tile"><HubIcon name="globe" size={18} class="text-ink" /></span>
                  <div class="min-w-0 flex-1">
                    <p class="text-small text-muted">Lien de l’annonce</p>
                    {siteUrl
                      ? <p class="break-all">{siteUrl.replace(/^https?:\/\//, "")}</p>
                      : <p>Pas encore de site. <a href="/app/visibilite" class="font-bold underline">Créer mon site</a></p>}
                  </div>
                </div>
              )}

              <div class="flex flex-col gap-2 px-[14px] pt-1 pb-3">
                {draft ? (
                  <div class="flex gap-2">
                    <button type="button" class="shortcut" data-copy={isGoogle ? googleCopyText(google!, phone.display, siteUrl) : metaCopyText(meta!, phone.display)}>
                      <HubIcon name="copy" class="text-action-ink" /><span data-copy-label>Copier</span>
                    </button>
                    <button type="button" class="shortcut" data-ads-generate={channel}>
                      <HubIcon name="rotate" class="text-action-ink" /><span data-label>Réécrire</span>
                    </button>
                  </div>
                ) : !none && (
                  <button type="button" class="btn btn-secondary w-full" data-ads-generate={channel}><span data-label>Écrire l’annonce</span></button>
                )}
                <p class="hidden text-small font-bold" data-ads-error role="alert"></p>
              </div>
            </div>
          </section>
        );
      })}
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <BudgetSlider />
      <section class="flex flex-col gap-[10px]">
        <h2 class="font-bold">Lancer la campagne</h2>
        <ul class="panel">
          <SoonRow icon="megaphone" label="Google Ads" line="Connexion à votre compte publicitaire Google." />
          <SoonRow icon="share" label="Facebook et Instagram" line="Connexion à votre compte publicitaire Meta." />
        </ul>
        <p class="text-small text-muted">En attendant, copiez les annonces dans votre compte publicitaire.</p>
      </section>
    </div>
  </main>
</AppShell>

<style>
  .kw { font-size: var(--text-small); padding: 4px 10px; border-radius: var(--radius-chip); background: var(--color-neutral-bg); box-shadow: inset 0 0 0 1px var(--color-neutral-line); }
</style>

<script>
  // Writes one or both drafts, then reloads to show them. On failure: French hint, button usable again.
  const FAIL = "L’annonce n’a pas pu être écrite. Réessayez dans un instant.";
  document.querySelectorAll<HTMLButtonElement>("[data-ads-generate]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const channels = (btn.dataset.adsGenerate ?? "").split(" ").filter(Boolean);
      const label = btn.querySelector("[data-label]");
      const before = label?.textContent ?? "";
      const err = (btn.closest("section") ?? btn.parentElement)?.querySelector<HTMLElement>("[data-ads-error]");
      document.querySelectorAll<HTMLButtonElement>("[data-ads-generate]").forEach((b) => (b.disabled = true));
      if (label) label.textContent = channels.length > 1 ? "Écriture des annonces…" : "Écriture de l’annonce…";
      err?.classList.add("hidden");
      const results = await Promise.all(channels.map(async (channel) => {
        try {
          const res = await fetch("/api/publicites/generate", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ channel }) });
          if (res.ok) return null;
          return ((await res.json().catch(() => ({}))) as { hint?: string }).hint || FAIL;
        } catch { return FAIL; }
      }));
      const failed = results.filter((r): r is string => !!r);
      // Reload as soon as at least one draft was written: the page shows it, the other can be retried
      if (failed.length < channels.length) return location.reload();
      document.querySelectorAll<HTMLButtonElement>("[data-ads-generate]").forEach((b) => (b.disabled = false));
      if (label) label.textContent = before;
      if (err) { err.textContent = failed[0]; err.classList.remove("hidden"); }
    });
  });
  // Copies a draft as plain text, ready to paste in the ad account
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const label = btn.querySelector("[data-copy-label]")!;
      try { await navigator.clipboard.writeText(btn.dataset.copy ?? ""); label.textContent = "Copié"; }
      catch { label.textContent = "Copie impossible"; }
      setTimeout(() => (label.textContent = "Copier"), 2000);
    });
  });
</script>
