---
// « Appels »: the artisan's list of calls (DESIGN.md « Ligne d'appel », « Filtre segmenté »; texts: COPY.md)
import Base from "../../layouts/Base.astro";
import CallRow from "../../components/CallRow.astro";
import SegmentedFilter from "../../components/SegmentedFilter.astro";
import Icon from "../../components/Icon.astro";
import { leadsForBusiness } from "../../lib/leads-list";
import { groupByDay, hourLabel, toCallBack } from "../../lib/leads-group";

const { business } = Astro.locals;
if (business && business.onboarding_step !== "done") return Astro.redirect("/onboarding");

const view = Astro.url.searchParams.get("vue") === "tous" ? "tous" : "rappeler";
const leads = business ? await leadsForBusiness(business.id) : [];
const pending = toCallBack(leads);
const groups = view === "tous" ? groupByDay(leads) : [];
---
<Base title="Appels">
  <main class="mx-auto flex min-h-dvh max-w-[480px] flex-col gap-[14px] px-4 pt-6 pb-6">
    <div class="flex items-center justify-between">
      <h1 class="text-title font-bold">Appels</h1>
      <a href="/app/reglages" aria-label="Réglages" class="-mr-3 grid h-12 w-12 place-items-center rounded-call text-ink"><Icon name="settings" /></a>
    </div>
    <SegmentedFilter view={view} count={pending.length} />

    {leads.length === 0 ? (
      <div class="py-12 text-center">
        <p class="font-bold">Aucun appel</p>
        <p class="mt-1 text-small text-muted">Vos appels s’afficheront ici.</p>
      </div>
    ) : view === "rappeler" ? (
      pending.length === 0 ? (
        <div class="py-12 text-center">
          <p class="font-bold">Personne à rappeler</p>
          <p class="mt-1 text-small text-muted">Les nouveaux appels s’afficheront ici.</p>
        </div>
      ) : (
        <ul class="panel">{pending.map((lead) => <CallRow lead={lead} />)}</ul>
      )
    ) : (
      groups.map((g) => (
        <section>
          <h2 class="px-[14px] pb-2 text-small font-bold text-muted">{g.label}</h2>
          <ul class="panel">{g.items.map((lead) => <CallRow lead={lead} when={hourLabel(lead.created_at)} />)}</ul>
        </section>
      ))
    )}

    <form method="post" action="/api/auth/logout" class="mt-auto flex justify-center pt-6">
      <button class="min-h-12 px-4 text-small text-muted underline underline-offset-2">Se déconnecter</button>
    </form>
  </main>
</Base>
