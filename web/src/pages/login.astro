---
import Base from "../layouts/Base.astro";
if (Astro.locals.user) return Astro.redirect("/app");
const expired = Astro.url.searchParams.has("expired");
---
<Base title="Connexion">
  <main class="mx-auto max-w-sm px-4 py-24">
    <h1 class="text-2xl font-semibold">Connexion</h1>
    {expired && <p class="mt-2 text-sm text-red-600">Ce lien a expiré. Demandez-en un nouveau.</p>}
    <form id="magic" class="mt-6 flex flex-col gap-3">
      <input name="email" type="email" required placeholder="vous@exemple.fr" class="rounded-lg border px-3 py-2" />
      <button class="rounded-lg bg-neutral-900 px-3 py-2 text-white">Recevoir un lien de connexion</button>
      <p id="magic-result" class="text-sm text-neutral-600"></p>
    </form>
    <form method="post" action="/api/auth/demo" class="mt-8">
      <button class="w-full rounded-lg border px-3 py-2">Voir la démo</button>
    </form>
  </main>
  <script>
    const form = document.getElementById("magic") as HTMLFormElement;
    const out = document.getElementById("magic-result")!;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const res = await fetch("/api/auth/magic", { method: "POST", body: new FormData(form) });
      const data = (await res.json()) as { sent?: boolean; link?: string };
      if (!res.ok) { out.textContent = "Adresse e-mail invalide."; return; }
      if (data.sent) { out.textContent = "Lien envoyé. Regardez vos e-mails."; return; }
      // No e-mail provider configured (dev/demo): show the link directly
      out.innerHTML = "";
      const a = document.createElement("a");
      a.href = data.link ?? "#"; a.textContent = "Ouvrir le lien de connexion"; a.className = "underline";
      out.appendChild(a);
    });
  </script>
</Base>
