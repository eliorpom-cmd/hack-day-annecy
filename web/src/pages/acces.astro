---
// Team password page: unlocks the demo, sign-up and everything that calls paid services (lib/gate.ts).
import Base from "../layouts/Base.astro";
import { secret } from "../lib/env";
import { GATE_COOKIE, GATE_DAYS, gateToken, passwordMatches, safeNext } from "../lib/gate";

const next = safeNext(Astro.url.searchParams.get("next"));
let wrong = false;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const password = secret("ACCESS_PASSWORD");
  if (await passwordMatches(String(form.get("password") ?? ""), password)) {
    Astro.cookies.set(GATE_COOKIE, await gateToken(password!), {
      path: "/", httpOnly: true, sameSite: "lax", secure: Astro.url.protocol === "https:", maxAge: GATE_DAYS * 86400,
    });
    return Astro.redirect(next, 303);
  }
  wrong = true;
}
---
<Base title="Accès réservé">
  <main class="mx-auto flex min-h-dvh max-w-[480px] flex-col px-4">
    <div class="flex flex-1 flex-col justify-center gap-6 py-10">
      <div>
        <h1 class="text-title font-bold">Accès réservé</h1>
        <p class="mt-2 text-muted">Cette partie est réservée à l'équipe. Entrez le mot de passe.</p>
      </div>
      <form method="post" class="flex flex-col gap-4">
        <div>
          <label class="field">
            <span class="field-label">Mot de passe</span>
            <input name="password" type="password" required autocomplete="current-password" placeholder=" " class="field-input" autofocus />
          </label>
          {wrong && <p class="mx-4 mt-1 text-small text-urgence">Mot de passe incorrect.</p>}
        </div>
        <button class="btn btn-primary">Entrer</button>
      </form>
      <a href="/" class="text-small text-muted underline">Retour à l'accueil</a>
    </div>
  </main>
</Base>
