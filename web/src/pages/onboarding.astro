---
// Setup flow (« configuration » in the UI), 4 steps on one page: activity, voice, number, test call.
// Values: DESIGN.md, texts: COPY.md « Configuration ». Data goes through the JSON API (PROJET.md).
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Field from "../components/setup/Field.astro";
import Progress from "../components/setup/Progress.astro";
import { STEPS } from "../components/setup/steps";
import { db } from "../lib/db";

const b = Astro.locals.business;
if (!b) return Astro.redirect("/login");

// Resume where the artisan stopped. The test step has no stored value: « done » + ?etape=4 shows it.
const stored = { business: 1, voice: 2, number: 3, done: 4 }[b.onboarding_step] ?? 1;
const asked = Number(Astro.url.searchParams.get("etape"));
if (b.onboarding_step === "done" && !asked) return Astro.redirect("/app");
const step = asked >= 1 && asked <= 4 ? Math.min(asked, stored) : stored;

const [hours, faqs, numbers] = await Promise.all([
  db().prepare("SELECT weekday, opens, closes FROM business_hours WHERE business_id = ? ORDER BY weekday, opens").bind(b.id).all(),
  db().prepare("SELECT id, question, answer, kind FROM faqs WHERE business_id = ? ORDER BY kind, created_at").bind(b.id).all(),
  db().prepare("SELECT e164 FROM phone_numbers WHERE business_id = ?").bind(b.id).all<{ e164: string }>(),
]);
const init = {
  step,
  business: {
    name: b.name, trade: b.trade, city: b.city, description: b.description, website: b.website,
    artisan_phone: b.artisan_phone, ring_seconds: b.ring_seconds, greeting: b.greeting, voice_id: b.voice_id, voice_name: b.voice_name,
    first_name: b.first_name ?? "", last_name: b.last_name ?? "", voice_gender: b.voice_gender ?? null,
    forwarding_mode: b.forwarding_mode ?? null,
  },
  hours: hours.results,
  faqs: faqs.results,
  number: numbers.results[0]?.e164 ?? null,
};
// Filled once: a company name, or the name of a self-employed artisan
const filled = !!(b.name || b.last_name);
---
<Base title="Configuration">
  <main class="mx-auto flex min-h-dvh max-w-[480px] flex-col">
    <div class="flex flex-1 flex-col gap-[14px] px-4 pt-4 pb-4">
      <a href="?etape=1" data-back class="flex items-center gap-1 self-start font-bold text-ink" style="min-height:48px" hidden>
        <Icon name="chevron-left" /><span data-back-label></span>
      </a>
      <Progress step={step} />

      <!-- 1 · Votre activité -->
      <section data-step="1" class="flex flex-col gap-[14px]" hidden>
        <div>
          <h1 class="text-title font-bold">Votre activité</h1>
          <p class="mt-2 text-muted" data-lead-site>Le répondeur lit votre site pour connaître votre métier, vos horaires et vos prix.</p>
          <p class="mt-2 text-muted" data-lead-form hidden>Le répondeur donne ces informations aux clients qui appellent.</p>
        </div>

        <form data-phase="site" class="flex flex-col gap-[14px]" novalidate hidden={filled}>
          <Field id="website" label="Adresse de votre site" help="Exemple : plomberie-martin.fr" inputmode="url" autocomplete="url" value={b.website} />
          <div data-scanning class="flex flex-col gap-2" hidden>
            <p class="font-bold" role="status">Lecture de votre site…</p>
            <div class="scan-bar"><span></span></div>
            <p class="text-small text-muted">Cela prend jusqu’à 30 secondes.</p>
          </div>
        </form>

        <div data-phase="form" class="flex flex-col gap-[14px]" hidden={!filled}>
          <p data-scan-note-box class="panel flex items-start gap-3 px-[14px] py-3" hidden><span class="icon-tile"><Icon name="check" size={18} /></span><span data-scan-note></span></p>
          <Field id="name" label="Nom de l’entreprise (facultatif)" value={b.name} maxlength={120} autocomplete="organization" help="Sans nom d’entreprise, le répondeur dit votre prénom, votre nom et votre métier." />
          <Field id="first_name" label="Votre prénom" value={b.first_name} maxlength={60} autocomplete="given-name" help="Le répondeur le dit aux clients : « Marc vous rappelle. »" />
          <Field id="last_name" label="Votre nom" value={b.last_name} maxlength={60} autocomplete="family-name" />
          <Field id="trade" label="Votre métier" value={b.trade} maxlength={80} />
          <Field id="city" label="Ville" value={b.city} maxlength={80} autocomplete="address-level2" />
          <Field id="description" label="Ce que vous faites" value={b.description} multiline maxlength={2000} />
          <Field id="phone1" label="Votre portable" type="tel" inputmode="tel" autocomplete="tel" value={b.artisan_phone} help="Il sonne en premier quand un client appelle." />

          <h2 class="mt-2 text-small font-bold text-muted">Horaires</h2>
          <div class="panel" role="radiogroup" aria-label="Horaires">
            <label class="row cursor-pointer">
              <input type="radio" name="hours-mode" value="fixed" class="radio" data-hours-mode />
              <span class="flex flex-1 flex-col"><span class="font-bold">Horaires fixes</span><span class="text-small text-muted">Hors horaires, le répondeur décroche tout de suite.</span></span>
            </label>
            <label class="row cursor-pointer">
              <input type="radio" name="hours-mode" value="none" class="radio" data-hours-mode />
              <span class="flex flex-1 flex-col"><span class="font-bold">Pas d’horaires fixes</span><span class="text-small text-muted">Votre portable sonne d’abord, à toute heure.</span></span>
            </label>
          </div>
          <div class="panel" data-hours></div>
          <p class="-mt-2 mx-4 text-small text-muted" data-hours-note>Pendant vos horaires, votre portable sonne d’abord.</p>

          <h2 class="mt-2 text-small font-bold text-muted">Questions et prix</h2>
          <div class="panel" data-faqs></div>
          <div class="panel flex flex-col gap-[14px] p-[14px]" data-faq-add hidden>
            <p class="font-bold" data-faq-add-title>Ajouter une question</p>
            <Field id="faq-q" label="Question" multiline maxlength={300} />
            <Field id="faq-a" label="Réponse" multiline maxlength={2000} />
            <button type="button" class="btn btn-secondary w-full" data-faq-add-save>Ajouter</button>
            <button type="button" class="min-h-12 text-small font-bold text-muted" data-faq-add-cancel>Annuler</button>
          </div>
          <p class="-mt-2 mx-4 text-small text-muted">Le répondeur s’en sert pour répondre aux clients.</p>
        </div>

        <!-- Interview: the questions clients ask that the site did not answer, one at a time -->
        <div data-phase="interview" class="flex flex-col gap-[14px]" hidden>
          <p data-interview-loading class="text-muted" role="status">Préparation des questions…</p>
          <div data-interview-card class="flex flex-col gap-[14px]" hidden>
            <div class="panel">
              <div class="row items-start">
                <span class="icon-tile" data-interview-icon></span>
                <div class="flex-1">
                  <p class="text-small text-muted" data-interview-count></p>
                  <p class="text-small text-muted">Le répondeur aimerait savoir :</p>
                  <p class="font-bold" data-interview-question></p>
                </div>
              </div>
            </div>
            <Field id="interview-answer" label="Votre réponse" multiline maxlength={2000} />
            <button type="button" class="link-btn self-start" data-interview-stop>Passer toutes les questions</button>
          </div>
        </div>
      </section>

      <!-- 2 · Voix du répondeur -->
      <section data-step="2" class="flex flex-col gap-[14px]" hidden>
        <div>
          <h1 class="text-title font-bold">Voix du répondeur</h1>
          <p class="mt-2 text-muted">Les clients entendent cette voix quand le répondeur décroche.</p>
        </div>
        <p data-voices-status class="text-muted" role="status">Chargement des voix…</p>
        <div data-voices-wrap class="flex flex-col gap-[14px]" role="radiogroup" aria-label="Voix" hidden>
          <!-- Option card: the artisan's own voice -->
          <div class="panel">
            <label class="row cursor-pointer">
              <input type="radio" name="voice" value="__clone" class="radio" data-clone-radio />
              <span class="flex flex-1 flex-col"><span class="font-bold">Utiliser ma voix</span><span class="text-small text-muted" data-clone-sub>Vous lisez 3 phrases, le répondeur parle comme vous.</span></span>
              <span class="icon-tile"><Icon name="mic" size={18} /></span>
            </label>
            <div class="row" data-clone-ready hidden>
              <span class="icon-tile"><Icon name="check" size={18} /></span>
              <p class="flex-1">Votre voix est prête.</p>
              <button type="button" class="link-btn" data-clone-redo>Enregistrer à nouveau</button>
            </div>
          </div>

          <!-- Recorder, shown when « Utiliser ma voix » is chosen -->
          <div data-clone class="flex flex-col gap-[14px]" hidden>
            <div class="panel">
              <div class="row items-start">
                <span class="icon-tile"><Icon name="message" size={18} /></span>
                <div class="flex-1"><p class="text-small text-muted" data-clone-count></p><p class="font-bold" data-clone-sentence></p></div>
              </div>
              <div class="flex flex-col items-center gap-2 px-[14px] pt-2 pb-4" data-rec-box>
                <button type="button" class="rec-btn" data-rec aria-label="Enregistrer la phrase"><Icon name="mic" size={28} /></button>
                <p class="text-small text-muted text-center" data-rec-status role="status">Appuyez, puis lisez la phrase à voix haute.</p>
              </div>
            </div>
            <div class="panel" data-takes hidden></div>
            <label class="panel row cursor-pointer">
              <input type="checkbox" class="checkbox" data-consent />
              <span>J’accepte que ma voix soit utilisée par mon répondeur.</span>
            </label>
          </div>

          <h2 class="mt-2 text-small font-bold text-muted">Ou choisissez une voix</h2>
          <div class="panel" data-voices></div>
        </div>
        <Field id="greeting" label="Phrase d’accueil" value={b.greeting} multiline maxlength={300} help="Le répondeur la dit en décrochant." />
        <p data-agent-error class="panel flex items-start gap-3 px-[14px] py-3" hidden>
          <span class="icon-tile"><Icon name="alert" size={18} /></span>
          <span><span class="font-bold">Le répondeur n’est pas encore branché.</span> Vos choix sont enregistrés, vous pouvez continuer.</span>
        </p>
      </section>

      <!-- 3 · Votre numéro -->
      <section data-step="3" class="flex flex-col gap-[14px]" hidden>
        <div>
          <h1 class="text-title font-bold">Votre numéro</h1>
          <p class="mt-2 text-muted" data-number-lead></p>
        </div>
        <div class="panel" role="radiogroup" aria-label="Numéro donné aux clients">
          <label class="row cursor-pointer">
            <input type="radio" name="forwarding" value="renvoi" class="radio" data-forwarding />
            <span class="flex flex-1 flex-col"><span class="font-bold">Garder mon numéro (recommandé)</span><span class="text-small text-muted">Rien à changer sur Google ni sur vos devis.</span></span>
          </label>
          <label class="row cursor-pointer">
            <input type="radio" name="forwarding" value="numero" class="radio" data-forwarding />
            <span class="flex flex-1 flex-col"><span class="font-bold">Prendre un nouveau numéro</span><span class="text-small text-muted">Vous donnez ce numéro à vos clients.</span></span>
          </label>
        </div>
        <Field id="phone3" label="Votre portable" type="tel" inputmode="tel" autocomplete="tel" value={b.artisan_phone} help="Exemple : 06 12 34 56 78" />

        <div class="panel">
          <div class="row">
            <span class="icon-tile"><Icon name="timer" size={18} /></span>
            <div class="flex-1"><p class="text-small text-muted">Durée de sonnerie</p><p><span data-ring>{b.ring_seconds}</span> secondes</p></div>
            <button type="button" class="step-btn" data-ring-step="-5" aria-label="5 secondes de moins"><Icon name="minus" /></button>
            <button type="button" class="step-btn" data-ring-step="5" aria-label="5 secondes de plus"><Icon name="plus" /></button>
          </div>
        </div>
        <p class="-mt-2 mx-4 text-small text-muted">Ensuite, le répondeur décroche.</p>

        <h2 class="mt-2 text-small font-bold text-muted" data-numbers-title>Choisissez votre numéro</h2>
        <p data-numbers-status class="text-muted" role="status">Recherche des numéros…</p>
        <div class="panel" data-numbers role="radiogroup" aria-label="Numéros" hidden></div>
        <p data-renvoi-note class="mx-4 text-small text-muted" hidden>Le numéro du répondeur est choisi pour vous. Continuez pour voir les codes à composer.</p>

        <!-- Call forwarding codes, once the répondeur number is live (mode « Garder mon numéro ») -->
        <div data-codes class="flex flex-col gap-[14px]" hidden>
          <h2 class="mt-2 text-small font-bold text-muted">Activez le renvoi sur votre portable</h2>
          <p class="-mt-2">Composez ces 3 codes depuis votre portable, un par un. Ils renvoient vers le répondeur, au <span class="font-bold" data-codes-number></span>.</p>
          <div class="panel" data-codes-list></div>
          <p class="mx-4 -mt-2 text-small text-muted">Pour arrêter : <a class="font-bold text-ink underline underline-offset-2" data-codes-stop href="tel:%23%23002%23">##002#</a></p>
        </div>
        <p data-numbers-error class="panel flex items-start gap-3 px-[14px] py-3" hidden>
          <span class="icon-tile"><Icon name="alert" size={18} /></span>
          <span data-numbers-error-text></span>
        </p>
      </section>

      <!-- 4 · Essai -->
      <section data-step="4" class="flex flex-col gap-[14px]" hidden>
        <div>
          <h1 class="text-title font-bold">Essai</h1>
          <p class="mt-2 font-bold" data-ready>Votre répondeur est prêt.</p>
        </div>
        <div data-has-number class="flex flex-col gap-[14px]">
          <a data-test-link href="#" class="panel flex flex-col gap-1 px-[14px] py-4">
            <span class="text-small text-muted" data-test-label>Appelez ce numéro pour l’essayer</span>
            <span data-test-number class="text-title font-bold"></span>
          </a>
          <p class="mx-4 -mt-1 text-small text-muted" data-test-help>Appelez depuis un autre téléphone que votre portable.</p>

          <h2 class="mt-2 text-small font-bold text-muted" data-give-title>Donnez ce numéro à vos clients</h2>
          <div class="panel" data-give>
            <div class="row"><span class="icon-tile"><Icon name="globe" size={18} /></span><p>Sur votre site et votre fiche Google</p></div>
            <div class="row"><span class="icon-tile"><Icon name="file-text" size={18} /></span><p>Sur vos devis et vos factures</p></div>
            <div class="row"><span class="icon-tile"><Icon name="truck" size={18} /></span><p>Sur votre camion et vos cartes de visite</p></div>
          </div>
          <p class="mx-4 -mt-2 text-small text-muted">Après chaque appel, vous recevez un message avec le nom du client et sa demande.</p>
        </div>
        <div data-no-number class="panel flex items-start gap-3 px-[14px] py-3" hidden>
          <span class="icon-tile"><Icon name="alert" size={18} /></span>
          <p><span class="font-bold">Pas encore de numéro.</span> Revenez à l’étape précédente pour en choisir un et essayer le répondeur.</p>
        </div>
      </section>
    </div>

    <!-- Bottom bar: one green button per step (DESIGN.md « Barre du bas ») -->
    <div class="sticky bottom-0 flex flex-col gap-2 bg-page px-4 pt-3 pb-6">
      <p data-error class="mx-4 text-small font-bold" role="alert" hidden></p>
      <button type="button" data-primary class="btn btn-primary w-full">Continuer</button>
      <button type="button" data-secondary class="btn btn-secondary w-full" hidden></button>
    </div>

    <!-- Icons cloned by the client script into rows it builds -->
    <template data-icon="euro"><span class="icon-tile"><Icon name="euro" size={18} /></span></template>
    <template data-icon="euro-sm"><Icon name="euro" size={18} /></template>
    <template data-icon="help-sm"><Icon name="help" size={18} /></template>
    <template data-icon="help"><span class="icon-tile"><Icon name="help" size={18} /></span></template>
    <template data-icon="clock"><span class="icon-tile"><Icon name="clock" size={18} /></span></template>
    <template data-icon="phone"><span class="icon-tile"><Icon name="phone" size={18} /></span></template>
    <template data-icon="trash"><Icon name="trash" /></template>
    <template data-icon="plus"><Icon name="plus" /></template>
    <template data-icon="play"><Icon name="play" /></template>
    <template data-icon="pause"><Icon name="pause" /></template>
    <template data-icon="check"><Icon name="check" /></template>
    <template data-icon="check-tile"><span class="icon-tile"><Icon name="check" size={18} /></span></template>
    <template data-icon="mic"><Icon name="mic" size={28} /></template>
    <template data-icon="mic-sm"><Icon name="mic" /></template>
    <template data-icon="square"><Icon name="square" size={24} /></template>
    <template data-icon="rotate"><Icon name="rotate" /></template>

    <script type="application/json" id="setup-init" set:html={JSON.stringify(init).replace(/</g, "\\u003c")} />
    <script type="application/json" id="setup-steps" set:html={JSON.stringify(STEPS)} />
  </main>

  <script>
    import { DAYS } from "../components/setup/steps";
    import { businessDisplayName, defaultGreeting, isDefaultGreeting, type GreetingVoice } from "../lib/greeting";
    import { forwardingCodes, forwardingDelay } from "../lib/forwarding";
    import { CLONE_LIMITS, CLONE_SENTENCES, CLONED_VOICE_NAME, encodeWav } from "../lib/voice-clone";

    // ---------- Types and initial state (rendered by the server) ----------
    type Hour = { weekday: number; opens: string; closes: string };
    type Faq = { id?: string; question: string; answer: string; kind: "info" | "price" };
    type Voice = { id: string; name: string; preview_url: string | null; category?: string; gender?: "female" | "male" | null };
    type Init = {
      step: number;
      business: { name: string; trade: string; city: string; description: string; website: string | null; artisan_phone: string | null;
        ring_seconds: number; greeting: string; voice_id: string | null; voice_name: string | null;
        first_name: string; last_name: string; voice_gender: "female" | "male" | null; forwarding_mode: "renvoi" | "numero" | null };
      hours: Hour[]; faqs: (Faq & { id: string })[]; number: string | null;
    };
    const init = JSON.parse(document.getElementById("setup-init")!.textContent!) as Init;
    const STEPS = JSON.parse(document.getElementById("setup-steps")!.textContent!) as string[];
    const biz = init.business;

    const $ = <T extends Element = HTMLElement>(sel: string, root: Document | HTMLElement = document) => root.querySelector(sel) as T;
    const $$ = <T extends Element = HTMLElement>(sel: string, root: Document | HTMLElement = document) => [...root.querySelectorAll(sel)] as T[];
    const input = (id: string) => document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement;
    const icon = (name: string) => ($<HTMLTemplateElement>(`template[data-icon="${name}"]`).content.cloneNode(true) as DocumentFragment);
    function el<K extends keyof HTMLElementTagNameMap>(tag: K, attrs: Record<string, string> = {}, ...kids: (Node | string)[]) {
      const e = document.createElement(tag);
      for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
      // appendChild: the Workers types shadow the DOM Element.append signature
      for (const k of kids) e.appendChild(typeof k === "string" ? document.createTextNode(k) : k);
      return e;
    }

    // French phone display: +33612345678 → 06 12 34 56 78
    function frPhone(p: string | null | undefined) {
      const m = /^\+33([1-9])(\d{2})(\d{2})(\d{2})(\d{2})$/.exec((p ?? "").replace(/\s+/g, ""));
      return m ? `0${m[1]} ${m[2]} ${m[3]} ${m[4]} ${m[5]}` : (p ?? "");
    }

    type ApiResult<T> = { ok: boolean; status: number; data: T & { error?: string; hint?: string } };
    async function api<T = Record<string, unknown>>(method: string, url: string, body?: unknown): Promise<ApiResult<T>> {
      try {
        const res = await fetch(url, { method, headers: body === undefined ? {} : { "Content-Type": "application/json" }, body: body === undefined ? undefined : JSON.stringify(body) });
        const data = res.status === 204 ? {} : await res.json().catch(() => ({}));
        return { ok: res.ok, status: res.status, data: data as ApiResult<T>["data"] };
      } catch {
        return { ok: false, status: 0, data: { error: "network", hint: "Pas de connexion. Vérifiez votre réseau et réessayez." } as ApiResult<T>["data"] };
      }
    }

    // ---------- Bottom bar and errors ----------
    const primary = $<HTMLButtonElement>("[data-primary]");
    const secondary = $<HTMLButtonElement>("[data-secondary]");
    const errorLine = $("[data-error]");
    let onPrimary: () => unknown = () => {};
    let onSecondary: () => unknown = () => {};
    primary.addEventListener("click", () => { if (!primary.disabled) onPrimary(); });
    secondary.addEventListener("click", () => { if (!secondary.disabled) onSecondary(); });

    function showError(msg: string | null) {
      errorLine.textContent = msg ?? "";
      errorLine.hidden = !msg;
    }
    function bar(label: string, iconName: string | null, second: string | null) {
      primary.replaceChildren(...(iconName ? [icon(iconName)] : []), label);
      secondary.textContent = second ?? "";
      secondary.hidden = !second;
    }
    function busy(on: boolean, label?: string) {
      primary.disabled = on;
      secondary.disabled = on;
      primary.style.opacity = on ? "0.6" : "";
      if (on && label) primary.textContent = label;
    }
    // Field-level message under a Material field (replaces its supporting text)
    function fieldHelp(id: string, msg: string | null, strong = false) {
      const help = document.getElementById(`${id}-help`)!;
      const text = msg ?? help.dataset.default ?? "";
      help.textContent = text;
      help.hidden = !text;
      help.classList.toggle("font-bold", strong);
      help.classList.toggle("text-ink", strong);
      help.classList.toggle("text-muted", !strong);
    }

    // An error under a field goes away as soon as the artisan corrects it
    document.addEventListener("input", (e) => {
      const id = (e.target as HTMLElement).id;
      const help = id ? document.getElementById(`${id}-help`) : null;
      if (help?.classList.contains("font-bold")) fieldHelp(id, null);
    });

    // ---------- Navigation between steps ----------
    let current = 0;
    const back = $<HTMLAnchorElement>("[data-back]");
    function go(n: number, push = true) {
      current = n;
      for (const s of $$("[data-step]")) s.hidden = s.dataset.step !== String(n);
      $$("[data-seg]").forEach((seg, i) => { seg.classList.toggle("bg-ink", i < n); seg.classList.toggle("bg-line", i >= n); });
      $("[data-progress-n]").textContent = String(n);
      $("[data-progress-name]").textContent = STEPS[n - 1];
      back.hidden = n === 1;
      back.href = `?etape=${n - 1}`;
      $("[data-back-label]").textContent = STEPS[n - 2] ?? "";
      showError(null);
      if (push) history.pushState({ step: n }, "", `?etape=${n}`);
      window.scrollTo(0, 0);
      enter[n]();
    }
    back.addEventListener("click", (e) => { e.preventDefault(); go(current - 1); });
    window.addEventListener("popstate", (e) => go((e.state as { step?: number } | null)?.step ?? init.step, false));

    // ---------- Step 1 · Votre activité ----------
    const sitePhase = $("[data-phase=site]");
    const formPhase = $("[data-phase=form]");
    const scanning = $("[data-scanning]");
    let hours: Hour[] = init.hours.length ? init.hours.map((h) => ({ ...h })) : [];
    // « Pas d’horaires fixes »: no rows saved, his phone rings first at any time. A saved record without hours is that choice.
    let noFixedHours = !init.hours.length && !!(biz.name || biz.last_name);
    const defaultHours = () => [0, 1, 2, 3, 4].map((weekday) => ({ weekday, opens: "08:00", closes: "18:00" }));
    for (const r of $$<HTMLInputElement>("[data-hours-mode]")) {
      r.addEventListener("change", () => {
        noFixedHours = r.value === "none";
        if (!noFixedHours && !hours.length) hours = defaultHours();
        renderHours();
      });
    }
    let faqs: Faq[] = init.faqs.map((f) => ({ ...f }));
    const deletedFaqs = new Set<string>();
    let scannedUrl: string | null = null;

    const interviewPhase = $("[data-phase=interview]");
    let phase: "site" | "form" | "interview" = formPhase.hidden ? "site" : "form";
    function showPhase(p: "site" | "form" | "interview") {
      phase = p;
      sitePhase.hidden = p !== "site";
      formPhase.hidden = p !== "form";
      interviewPhase.hidden = p !== "interview";
      $("[data-lead-site]").hidden = p !== "site";
      $("[data-lead-form]").hidden = p === "site";
      $("[data-lead-form]").textContent = p === "interview"
        ? "Vos clients posent souvent ces questions. Le répondeur s’en sert pour leur répondre."
        : "Le répondeur donne ces informations aux clients qui appellent.";
      if (p === "interview") return;
      if (phase === "site") {
        bar("Continuer", null, "Je n’ai pas de site");
        onPrimary = scan;
        onSecondary = () => {
          scannedUrl = null;
          if (!hours.length) hours = defaultHours();
          renderHours(); renderFaqs(); showPhase("form");
          prepareQuestions();
          input("name").focus();
        };
      } else {
        bar("Continuer", null, null);
        onPrimary = saveActivity;
      }
    }

    async function scan() {
      const url = input("website").value.trim();
      if (!url) { fieldHelp("website", "Indiquez l’adresse de votre site."); input("website").focus(); return; }
      fieldHelp("website", null);
      scanning.hidden = false;
      busy(true);
      const r = await api<{ business: Partial<Init["business"]>; hours: Hour[]; faqs: Faq[]; source?: { ai_model?: string | null } }>("POST", "/api/onboarding/scan", { url });
      scanning.hidden = true;
      busy(false);
      if (!r.ok) {
        bar("Continuer", null, "Je n’ai pas de site");
        fieldHelp("website", r.status === 400
          ? "Cette adresse ne marche pas. Vérifiez-la, par exemple plomberie-martin.fr."
          : "Impossible de lire ce site. Vérifiez l’adresse ou remplissez la fiche à la main.", true);
        return;
      }
      const found = r.data.business ?? {};
      scannedUrl = found.website ?? url;
      const map: [string, string | null | undefined][] = [
        ["name", found.name], ["trade", found.trade], ["city", found.city], ["description", found.description], ["phone1", /^\+33[67]/.test(found.artisan_phone ?? "") ? frPhone(found.artisan_phone) : null],
      ];
      for (const [id, v] of map) {
        if (v && v.trim()) { input(id).value = v.trim(); fieldHelp(id, "Trouvé sur votre site. Corrigez si besoin."); }
      }
      if (r.data.hours?.length) hours = r.data.hours.map((h) => ({ ...h }));
      else if (!hours.length) hours = defaultHours();
      noFixedHours = false;
      // Scanned FAQs are added after the ones already saved (going back and scanning again must not duplicate them)
      const known = new Set(faqs.map((f) => f.question.trim().toLowerCase()));
      for (const f of r.data.faqs ?? []) if (!known.has(f.question.trim().toLowerCase())) faqs.push({ ...f });
      const note = $("[data-scan-note]");
      const count = (r.data.faqs ?? []).length;
      const aiMissed = r.data.source && !r.data.source.ai_model;
      note.textContent = aiMissed
        ? "Seuls le nom et le téléphone ont été trouvés. Complétez le reste."
        : `${count ? `${count} question${count > 1 ? "s" : ""} trouvée${count > 1 ? "s" : ""}` : "Aucune question trouvée"} sur votre site. Vérifiez chaque ligne.`;
      $("[data-scan-note-box]").hidden = false;
      renderHours(); renderFaqs(); showPhase("form");
      prepareQuestions();
    }

    // Hours: one row per weekday, each slot editable, « Fermé » when no slot
    const hoursBox = $("[data-hours]");
    function timeInput(value: string, label: string, onChange: (v: string) => void) {
      const t = el("input", { type: "time", class: "time-input", "aria-label": label, step: "900" }) as HTMLInputElement;
      t.value = value;
      t.addEventListener("change", () => onChange(t.value));
      return t;
    }
    function renderHours() {
      for (const r of $$<HTMLInputElement>("[data-hours-mode]")) r.checked = r.value === (noFixedHours ? "none" : "fixed");
      hoursBox.hidden = noFixedHours;
      $("[data-hours-note]").hidden = noFixedHours;
      hoursBox.replaceChildren(...DAYS.map((day, weekday) => {
        const slots = hours.filter((h) => h.weekday === weekday);
        const add = el("button", { type: "button", class: "step-btn", "aria-label": `Ajouter un créneau le ${day.toLowerCase()}` }, icon("plus"));
        add.addEventListener("click", () => {
          const last = slots[slots.length - 1];
          hours.push(last ? { weekday, opens: last.closes < "14:00" ? "14:00" : last.closes, closes: last.closes < "14:00" ? "18:00" : "20:00" } : { weekday, opens: "08:00", closes: "18:00" });
          renderHours();
        });
        const lines = slots.map((h) => {
          const remove = el("button", { type: "button", class: "step-btn text-muted", "aria-label": `Retirer ce créneau du ${day.toLowerCase()}` }, icon("trash"));
          remove.addEventListener("click", () => { hours.splice(hours.indexOf(h), 1); renderHours(); });
          return el("div", { class: "flex items-center gap-2" },
            timeInput(h.opens, `${day}, ouverture`, (v) => { h.opens = v; }),
            el("span", { class: "text-muted" }, "à"),
            timeInput(h.closes, `${day}, fermeture`, (v) => { h.closes = v; }),
            el("span", { class: "flex-1" }),
            remove);
        });
        return el("div", { class: "row flex-col items-stretch gap-2" },
          el("div", { class: "flex items-center gap-3" },
            icon("clock"),
            el("p", { class: "flex-1" }, el("span", { class: "font-bold" }, day), slots.length ? "" : el("span", { class: "text-muted" }, " · Fermé")),
            add),
          ...lines);
      }));
    }

    // FAQs: question + answer edited in place; the icon tells a price from an information
    const faqsBox = $("[data-faqs]");
    function autoText(value: string, cls: string, label: string, onInput: (v: string) => void) {
      const t = el("textarea", { class: `faq-text ${cls}`, rows: "1", "aria-label": label }) as HTMLTextAreaElement;
      t.value = value;
      t.addEventListener("input", () => onInput(t.value));
      return t;
    }
    function renderFaqs() {
      const rows = faqs.map((f) => {
        const remove = el("button", { type: "button", class: "step-btn text-muted", "aria-label": "Retirer cette question" }, icon("trash"));
        remove.addEventListener("click", () => { if (f.id) deletedFaqs.add(f.id); faqs.splice(faqs.indexOf(f), 1); renderFaqs(); });
        return el("div", { class: "row items-start" },
          icon(f.kind === "price" ? "euro" : "help"),
          el("div", { class: "flex min-w-0 flex-1 flex-col" },
            autoText(f.question, "font-bold", f.kind === "price" ? "Prestation" : "Question", (v) => { f.question = v; }),
            autoText(f.answer, "text-muted", f.kind === "price" ? "Prix" : "Réponse", (v) => { f.answer = v; })),
          remove);
      });
      const adder = (kind: "info" | "price", label: string) => {
        const b = el("button", { type: "button", class: "row w-full text-left font-bold" }, icon(kind === "price" ? "euro" : "help"), label);
        b.addEventListener("click", () => openFaqForm(kind));
        return b;
      };
      faqsBox.replaceChildren(...rows, adder("info", "Ajouter une question"), adder("price", "Ajouter un prix"));
    }

    // « Ajouter une question » opens a question + answer form; the row is added only once both are written
    const faqForm = $("[data-faq-add]");
    let faqFormKind: "info" | "price" = "info";
    const fieldLabel = (id: string) => $(`[data-field="${id}"] .field-label`);
    function openFaqForm(kind: "info" | "price") {
      faqFormKind = kind;
      const price = kind === "price";
      $("[data-faq-add-title]").textContent = price ? "Ajouter un prix" : "Ajouter une question";
      fieldLabel("faq-q").textContent = price ? "Prestation" : "Question";
      fieldLabel("faq-a").textContent = price ? "Prix" : "Réponse";
      input("faq-q").value = ""; input("faq-a").value = "";
      fieldHelp("faq-a", null);
      faqForm.hidden = false;
      input("faq-q").focus();
    }
    $("[data-faq-add-cancel]").addEventListener("click", () => { faqForm.hidden = true; });
    $("[data-faq-add-save]").addEventListener("click", () => {
      const question = input("faq-q").value.trim(), answer = input("faq-a").value.trim();
      if (!question || !answer) {
        fieldHelp("faq-a", faqFormKind === "price" ? "Indiquez la prestation et son prix." : "Indiquez la question et sa réponse.", true);
        return;
      }
      faqs.push({ question, answer, kind: faqFormKind });
      faqForm.hidden = true;
      renderFaqs();
    });

    async function saveActivity() {
      const name = input("name").value.trim();
      // Company name optional: a self-employed artisan gives his first and last name instead
      if (!name && !(input("first_name").value.trim() && input("last_name").value.trim())) {
        const missing = input("first_name").value.trim() ? "last_name" : "first_name";
        fieldHelp(missing, "Indiquez votre prénom et votre nom, ou le nom de votre entreprise.", true);
        input(missing).focus();
        return;
      }
      if (!faqForm.hidden && (input("faq-q").value.trim() || input("faq-a").value.trim())) {
        showError("Ajoutez ou annulez la question en cours."); return;
      }
      if (!noFixedHours) for (const h of hours) if (!h.opens || !h.closes || h.opens >= h.closes) {
        showError(`${DAYS[h.weekday]} : l’heure de fermeture doit être après l’ouverture.`); return;
      }
      const incomplete = faqs.find((f) => !f.question.trim() !== !f.answer.trim());
      if (incomplete) { showError("Chaque question a besoin d’une réponse."); return; }
      showError(null);
      busy(true, "Enregistrement…");
      const phone = input("phone1").value.trim();
      const r = await api<{ business: Init["business"] }>("PUT", "/api/business", {
        name, first_name: input("first_name").value, last_name: input("last_name").value, trade: input("trade").value, city: input("city").value, description: input("description").value,
        artisan_phone: phone, ...(scannedUrl ? { website: scannedUrl } : {}),
      });
      if (!r.ok) {
        busy(false); bar("Continuer", null, null);
        if (r.data.error === "invalid_field" && /portable/i.test(r.data.hint ?? "")) { fieldHelp("phone1", "Ce numéro ne marche pas. Exemple : 06 12 34 56 78", true); input("phone1").focus(); }
        else showError(r.data.hint ?? "Enregistrement impossible. Réessayez.");
        return;
      }
      Object.assign(biz, r.data.business);
      const steps: Promise<ApiResult<unknown>>[] = [api("PUT", "/api/business/hours", noFixedHours ? [] : hours)];
      for (const id of deletedFaqs) steps.push(api("DELETE", `/api/faqs/${id}`));
      for (const f of faqs.filter((x) => x.id && x.question.trim())) steps.push(api("PUT", `/api/faqs/${f.id}`, f));
      const fresh = faqs.filter((x) => !x.id && x.question.trim() && x.answer.trim());
      const created = fresh.length ? api<{ faqs: (Faq & { id: string })[] }>("POST", "/api/faqs", { faqs: fresh }) : null;
      const results = await Promise.all([...steps, ...(created ? [created] : [])]);
      const bad = results.find((x) => !x.ok && x.status !== 404);
      if (bad) { busy(false); bar("Continuer", null, null); showError(bad.data.hint ?? "Enregistrement impossible. Réessayez."); return; }
      // Remember the new ids so a second pass updates instead of duplicating
      const createdRes = created ? await created : null;
      createdRes?.data.faqs?.forEach((saved, i) => { fresh[i].id = saved.id; });
      deletedFaqs.clear();
      faqs = faqs.filter((f) => f.question.trim());
      await api("PUT", "/api/business", { onboarding_step: stepAtLeast("voice") });
      busy(false);
      // The portable typed here is reused on the number step
      input("phone3").value = frPhone(biz.artisan_phone);
      if (interviewDone) { go(2); return; }
      startInterview();
    }

    // An emptied company name no longer comes from the site: back to the default help
    input("name").addEventListener("input", () => { if (!input("name").value.trim()) fieldHelp("name", null); });

    // ---------- Step 1 · Interview: « Le répondeur aimerait savoir : … » ----------
    // Asked as soon as the form is shown (after the scan or « Je n’ai pas de site »), answered after « Continuer ».
    // Each answer becomes a FAQ (POST /api/faqs). The API falls back to a fixed list when the AI is unavailable.
    type Question = { question: string; kind: "info" | "price" };
    let questionsReq: Promise<Question[]> | null = null;
    let interviewDone = false;
    let questions: Question[] = [];
    let qIndex = 0;
    function prepareQuestions() {
      if (interviewDone) return;
      questionsReq = api<{ questions: Question[] }>("POST", "/api/onboarding/questions", {
        business: { name: input("name").value, trade: input("trade").value, city: input("city").value, description: input("description").value },
        faqs: faqs.filter((f) => f.question.trim()).map((f) => ({ question: f.question, answer: f.answer })),
      }).then((r) => (r.ok ? r.data.questions ?? [] : []));
    }
    async function startInterview() {
      showPhase("interview");
      window.scrollTo(0, 0);
      $("[data-interview-loading]").hidden = false;
      $("[data-interview-card]").hidden = true;
      busy(true);
      if (!questionsReq) prepareQuestions();
      questions = await questionsReq!;
      busy(false);
      // Questions answered meanwhile (manual add) are not asked again
      const known = new Set(faqs.map((f) => f.question.trim().toLowerCase()));
      questions = questions.filter((q) => !known.has(q.question.trim().toLowerCase()));
      $("[data-interview-loading]").hidden = true;
      if (!questions.length) { finishInterview(); return; }
      qIndex = 0;
      showQuestion();
    }
    function showQuestion() {
      const q = questions[qIndex];
      $("[data-interview-card]").hidden = false;
      $("[data-interview-count]").textContent = `Question ${qIndex + 1} sur ${questions.length}`;
      $("[data-interview-question]").textContent = q.question;
      $("[data-interview-icon]").replaceChildren(...icon(q.kind === "price" ? "euro-sm" : "help-sm").childNodes);
      const a = input("interview-answer");
      a.value = "";
      const help = $("#interview-answer-help");
      help.dataset.default = q.kind === "price" ? "Un prix ou une fourchette. Exemple : 40 € TTC." : "En une phrase, comme vous le diriez au téléphone.";
      fieldHelp("interview-answer", null);
      showError(null);
      bar("Suivant", null, "Passer");
      onPrimary = answerQuestion;
      onSecondary = nextQuestion;
      a.focus();
    }
    async function answerQuestion() {
      const q = questions[qIndex];
      const answer = input("interview-answer").value.trim();
      if (!answer) { fieldHelp("interview-answer", "Écrivez une réponse, ou appuyez sur Passer.", true); input("interview-answer").focus(); return; }
      busy(true, "Enregistrement…");
      const r = await api<{ faq: Faq & { id: string } }>("POST", "/api/faqs", { question: q.question, answer, kind: q.kind });
      busy(false);
      if (!r.ok) { bar("Suivant", null, "Passer"); showError(r.data.hint ?? "Enregistrement impossible. Réessayez."); return; }
      faqs.push(r.data.faq);
      nextQuestion();
    }
    function nextQuestion() {
      qIndex++;
      if (qIndex < questions.length) showQuestion(); else finishInterview();
    }
    function finishInterview() {
      interviewDone = true;
      renderFaqs();
      showPhase("form");
      go(2);
    }
    $("[data-interview-stop]").addEventListener("click", finishInterview);

    // Never move the stored step backwards when the artisan goes back and continues again
    const ORDER = ["business", "voice", "number", "done"] as const;
    let storedStep: (typeof ORDER)[number] = ORDER[Math.min(init.step, 4) - 1];
    function stepAtLeast(s: (typeof ORDER)[number]) {
      if (ORDER.indexOf(s) > ORDER.indexOf(storedStep)) storedStep = s;
      return storedStep;
    }

    // ---------- Step 2 · Voix du répondeur ----------
    const voicesBox = $("[data-voices]");
    let voices: Voice[] | null = null; // library voices (the artisan's own voice is kept apart)
    let ownVoice: Voice | null = null; // his cloned voice, once created
    let chosenVoice: string | null = biz.voice_id;
    let useOwn = false; // « Utiliser ma voix » chosen
    let agentFailed = false;
    const audio = new Audio();
    let playing: HTMLButtonElement | null = null;
    audio.addEventListener("ended", () => setPlaying(null));
    function setPlaying(btn: HTMLButtonElement | null) {
      if (playing) { playing.replaceChildren(icon("play")); playing.setAttribute("aria-label", playing.dataset.label!); }
      playing = btn;
      if (btn) { btn.replaceChildren(icon("pause")); btn.setAttribute("aria-label", "Arrêter l’extrait"); }
    }
    function playButton(label: string, src: () => string) {
      const play = el("button", { type: "button", class: "play-btn", "aria-label": label, "data-label": label }, icon("play")) as HTMLButtonElement;
      play.addEventListener("click", () => {
        if (playing === play) { audio.pause(); setPlaying(null); return; }
        audio.src = src();
        audio.play().then(() => setPlaying(play)).catch(() => setPlaying(null));
      });
      return play;
    }

    // Greeting follows the voice (COPY.md): « Oui allô, … » for his own voice, « l’assistant(e) » for a library voice.
    // A greeting the artisan wrote himself is never replaced.
    function voiceKind(): GreetingVoice {
      if (useOwn) return "cloned";
      return voices?.find((v) => v.id === chosenVoice)?.gender ?? null;
    }
    function syncGreeting() {
      const g = input("greeting");
      if (isDefaultGreeting(g.value)) g.value = defaultGreeting({ name: businessDisplayName(biz), first_name: biz.first_name, voice: voiceKind() });
    }

    async function loadVoices() {
      const status = $("[data-voices-status]");
      const r = await api<{ voices: Voice[] }>("GET", "/api/voices");
      if (!r.ok || !r.data.voices?.length) { status.textContent = "Impossible d’afficher les voix. Réessayez dans un instant."; return; }
      ownVoice = r.data.voices.find((v) => v.category === "cloned" && v.id === biz.voice_id) ?? null;
      voices = r.data.voices.filter((v) => v.category !== "cloned");
      if (ownVoice && chosenVoice === ownVoice.id) useOwn = true;
      if (!useOwn && (!chosenVoice || !voices.some((v) => v.id === chosenVoice))) chosenVoice = voices[0]?.id ?? null;
      status.hidden = true;
      $("[data-voices-wrap]").hidden = false;
      voicesBox.replaceChildren(...voices.map((v) => {
        const radio = el("input", { type: "radio", name: "voice", value: v.id, class: "radio" }) as HTMLInputElement;
        radio.checked = !useOwn && v.id === chosenVoice;
        radio.addEventListener("change", () => { chosenVoice = v.id; chooseOwn(false); });
        const label = el("label", { class: "flex min-h-[48px] flex-1 cursor-pointer items-center gap-3" }, radio, el("span", { class: "font-bold" }, v.name));
        const row = el("div", { class: "row" }, label);
        if (v.preview_url) row.appendChild(playButton(`Écouter ${v.name}`, () => v.preview_url!));
        return row;
      }));
      $<HTMLInputElement>("[data-clone-radio]").checked = useOwn;
      chooseOwn(useOwn);
    }

    // ---- The artisan's own voice: 3 sentences recorded in the browser, sent as WAV to /api/voices/clone ----
    const takes: ({ wav: Blob; url: string; seconds: number } | null)[] = CLONE_SENTENCES.map(() => null);
    let recordingAgain = false; // « Enregistrer à nouveau » after a voice was created
    let recorder: MediaRecorder | null = null;
    let recTimer = 0;
    let recIndex = 0;
    const recBtn = $<HTMLButtonElement>("[data-rec]");
    const recStatus = $("[data-rec-status]");
    const nextIndex = () => takes.findIndex((t) => !t);

    function chooseOwn(on: boolean) {
      useOwn = on;
      if (on) { audio.pause(); setPlaying(null); }
      const ready = !!ownVoice && !recordingAgain;
      $("[data-clone-ready]").hidden = !(on && ready);
      $("[data-clone]").hidden = !(on && !ready);
      $("[data-clone-sub]").textContent = ownVoice ? "Votre voix enregistrée." : "Vous lisez 3 phrases, le répondeur parle comme vous.";
      syncGreeting();
      renderRecorder();
      voiceBar();
    }
    $("[data-clone-radio]").addEventListener("change", () => chooseOwn(true));
    $("[data-clone-redo]").addEventListener("click", () => { recordingAgain = true; chooseOwn(true); });

    const fmtSec = (s: number) => `0:${String(Math.round(s)).padStart(2, "0")}`;
    function renderRecorder() {
      const i = recorder ? recIndex : nextIndex();
      const done = i === -1;
      $("[data-clone-count]").textContent = done ? "3 phrases enregistrées" : `Phrase ${i + 1} sur ${CLONE_SENTENCES.length}`;
      $("[data-clone-sentence]").textContent = done ? "Vous pouvez réécouter chaque phrase avant de créer votre voix." : CLONE_SENTENCES[i];
      $("[data-rec-box]").hidden = done;
      const list = takes.map((t, n) => {
        if (!t) return null;
        const redo = el("button", { type: "button", class: "step-btn", "aria-label": `Refaire la phrase ${n + 1}` }, icon("rotate"));
        redo.addEventListener("click", () => { if (recorder) return; URL.revokeObjectURL(t.url); takes[n] = null; renderRecorder(); voiceBar(); });
        return el("div", { class: "row" }, icon("check-tile"),
          el("p", { class: "flex-1" }, el("span", { class: "font-bold" }, `Phrase ${n + 1}`), el("span", { class: "text-muted" }, ` · ${fmtSec(t.seconds)}`)),
          playButton(`Écouter la phrase ${n + 1}`, () => t.url), redo);
      }).filter((x): x is HTMLDivElement => !!x);
      const box = $("[data-takes]");
      box.hidden = !list.length;
      box.replaceChildren(...list);
    }

    async function toWav(blob: Blob) {
      const ctx = new AudioContext();
      try {
        const buf = await ctx.decodeAudioData(await blob.arrayBuffer());
        const channels = Array.from({ length: buf.numberOfChannels }, (_, c) => buf.getChannelData(c));
        return { wav: new Blob([encodeWav(channels, buf.sampleRate) as Uint8Array<ArrayBuffer>], { type: "audio/wav" }), seconds: buf.duration };
      } finally { await ctx.close(); }
    }

    async function startRecording() {
      showError(null);
      let stream: MediaStream;
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: { channelCount: 1, echoCancellation: true, noiseSuppression: true } });
      } catch {
        recStatus.textContent = "Le micro est bloqué. Autorisez-le dans votre navigateur, ou choisissez une voix de la liste.";
        return;
      }
      recIndex = nextIndex();
      const chunks: Blob[] = [];
      const rec = new MediaRecorder(stream);
      recorder = rec;
      rec.addEventListener("dataavailable", (e) => { if (e.data.size) chunks.push(e.data); });
      rec.addEventListener("stop", async () => {
        stream.getTracks().forEach((t) => t.stop());
        clearInterval(recTimer);
        recorder = null;
        recBtn.classList.remove("is-recording");
        recBtn.replaceChildren(icon("mic"));
        recBtn.setAttribute("aria-label", "Enregistrer la phrase");
        try {
          const { wav, seconds } = await toWav(new Blob(chunks, { type: rec.mimeType }));
          if (seconds < CLONE_LIMITS.minSeconds) recStatus.textContent = "Trop court. Lisez toute la phrase, puis appuyez sur stop.";
          else { takes[recIndex] = { wav, url: URL.createObjectURL(wav), seconds }; recStatus.textContent = "Appuyez, puis lisez la phrase à voix haute."; }
        } catch {
          recStatus.textContent = "Enregistrement illisible. Réessayez.";
        }
        renderRecorder();
        voiceBar();
      });
      rec.start();
      const started = Date.now();
      recBtn.classList.add("is-recording");
      recBtn.replaceChildren(icon("square"));
      recBtn.setAttribute("aria-label", "Arrêter l’enregistrement");
      recStatus.textContent = "Enregistrement… 0:00";
      recTimer = window.setInterval(() => {
        const s = (Date.now() - started) / 1000;
        recStatus.textContent = `Enregistrement… ${fmtSec(s)}`;
        if (s >= 30) rec.stop();
      }, 250);
      renderRecorder();
    }
    recBtn.addEventListener("click", () => { if (recorder) recorder.stop(); else startRecording(); });

    async function createOwnVoice() {
      if (recorder) return;
      if (nextIndex() !== -1) { showError("Enregistrez les 3 phrases, ou choisissez une voix de la liste."); return; }
      if (!$<HTMLInputElement>("[data-consent]").checked) { showError("Cochez la case pour accepter que votre voix soit utilisée."); return; }
      showError(null);
      const form = new FormData();
      form.append("consent", "true");
      takes.forEach((t, n) => form.append("files", t!.wav, `phrase-${n + 1}.wav`));
      busy(true, "Création de votre voix…");
      let r: ApiResult<{ voice: Voice; business: Init["business"] }>;
      try {
        const res = await fetch("/api/voices/clone", { method: "POST", body: form });
        r = { ok: res.ok, status: res.status, data: (await res.json().catch(() => ({}))) as typeof r.data };
      } catch {
        r = { ok: false, status: 0, data: { hint: "Pas de connexion. Vérifiez votre réseau et réessayez." } as ApiResult<{ voice: Voice; business: Init["business"] }>["data"] };
      }
      busy(false);
      if (!r.ok) { voiceBar(); showError(r.data.hint ?? "Votre voix n’a pas pu être créée. Réessayez."); return; }
      Object.assign(biz, r.data.business);
      ownVoice = r.data.voice;
      chosenVoice = ownVoice.id;
      recordingAgain = false;
      takes.forEach((t, n) => { if (t) URL.revokeObjectURL(t.url); takes[n] = null; });
      input("greeting").value = biz.greeting || input("greeting").value;
      chooseOwn(true);
    }

    // One green button: « Créer ma voix » while the recorder is open, « Continuer » otherwise
    function voiceBar() {
      if (current !== 2) return;
      const recording = useOwn && (!ownVoice || recordingAgain);
      bar(recording ? "Créer ma voix" : "Continuer", recording ? "mic-sm" : null, null);
      onPrimary = recording ? createOwnVoice : saveVoice;
    }

    async function saveVoice() {
      if (agentFailed) { go(3); return; }
      const voice = useOwn ? ownVoice : voices?.find((v) => v.id === chosenVoice);
      if (!voice) { showError("Choisissez une voix."); return; }
      const greeting = input("greeting").value.trim() || defaultGreeting({ name: businessDisplayName(biz), first_name: biz.first_name, voice: voiceKind() });
      const voice_gender = useOwn ? null : voice.gender ?? null;
      const voice_name = useOwn ? CLONED_VOICE_NAME : voice.name;
      busy(true, "Enregistrement…");
      audio.pause(); setPlaying(null);
      const r = await api("PUT", "/api/business", { voice_id: voice.id, voice_name, voice_gender, greeting, onboarding_step: stepAtLeast("number") });
      if (!r.ok) { busy(false); voiceBar(); showError(r.data.hint ?? "Enregistrement impossible. Réessayez."); return; }
      biz.voice_id = voice.id; biz.voice_name = voice_name; biz.voice_gender = voice_gender; biz.greeting = greeting;
      busy(true, "Préparation du répondeur…");
      const agent = await api("POST", "/api/agent");
      busy(false);
      bar("Continuer", null, null);
      if (!agent.ok) {
        // No ElevenLabs key locally, or the service is down: the artisan can still go on
        agentFailed = true;
        $("[data-agent-error]").hidden = false;
        return;
      }
      go(3);
    }

    // ---------- Step 3 · Votre numéro ----------
    // « Garder mon numéro » (recommended, preselected) or « Prendre un nouveau numéro »
    let mode: "renvoi" | "numero" = biz.forwarding_mode ?? "renvoi";
    // Forwarding on no answer accepts 5 to 30 s; 20 s by default the first time
    let ring = Math.min(40, Math.max(5, biz.forwarding_mode === null && (biz.ring_seconds || 15) === 15 ? 20 : biz.ring_seconds || 15));
    const ringMax = () => (mode === "renvoi" ? 30 : 40);
    const ringOut = $("[data-ring]");
    ringOut.textContent = String(ring);
    for (const btn of $$<HTMLButtonElement>("[data-ring-step]")) {
      btn.addEventListener("click", () => {
        ring = Math.min(ringMax(), Math.max(5, ring + Number(btn.dataset.ringStep)));
        ringOut.textContent = String(ring);
        renderCodes();
      });
    }
    for (const r of $$<HTMLInputElement>("[data-forwarding]")) {
      r.addEventListener("change", () => { mode = r.value as typeof mode; renderMode(); });
    }
    // renvoi: the codes are shown once the répondeur number is live (at once when coming back to this step)
    let codesShown = biz.forwarding_mode === "renvoi" && !!init.number;
    function renderMode() {
      for (const r of $$<HTMLInputElement>("[data-forwarding]")) r.checked = r.value === mode;
      const renvoi = mode === "renvoi";
      if (renvoi) { ring = forwardingDelay(Math.min(ring, 30)); ringOut.textContent = String(ring); }
      $("[data-number-lead]").textContent = renvoi
        ? "Vos clients appellent votre numéro habituel. Si vous ne répondez pas, l’appel passe au répondeur."
        : "Vos clients appellent ce numéro. Votre portable sonne d’abord, puis le répondeur décroche.";
      $("[data-numbers-title]").hidden = renvoi;
      numbersBox.hidden = renvoi || !numbersBox.childElementCount;
      $("[data-renvoi-note]").hidden = !renvoi || codesShown || numbersEmpty || !numbersBox.childElementCount;
      $("[data-codes]").hidden = !(renvoi && codesShown && attached);
      if (current === 3) numberError($("[data-numbers-error-text]").textContent || null);
      renderCodes();
    }

    // The 3 codes with the répondeur number filled in, each with « Composer » (tel: link) and « Copier »
    function renderCodes() {
      if (!attached) return;
      $("[data-codes-number]").textContent = frPhone(attached);
      $("[data-codes-list]").replaceChildren(...forwardingCodes(attached, ring).map((c) => {
        const copy = el("button", { type: "button", class: "link-btn" }, "Copier") as HTMLButtonElement;
        copy.addEventListener("click", async () => {
          try { await navigator.clipboard.writeText(c.code); copy.textContent = "Copié"; }
          catch { copy.textContent = "Copie impossible"; }
          setTimeout(() => { copy.textContent = "Copier"; }, 2000);
        });
        return el("div", { class: "row flex-col items-stretch gap-0" },
          el("span", { class: "text-small text-muted" }, c.label),
          el("span", { class: "font-bold break-all" }, c.code),
          el("div", { class: "-mb-2 flex gap-4" }, el("a", { href: c.href, class: "link-btn grid place-items-center" }, "Composer"), copy));
      }));
    }
    const numbersBox = $("[data-numbers]");
    let chosenNumber: string | null = init.number;
    let attached: string | null = init.number;
    let numbersLoaded = false;

    let numbersEmpty = false;
    function numberError(msg: string | null) {
      $("[data-numbers-error]").hidden = !msg;
      $("[data-numbers-error-text]").textContent = msg ?? "";
      const codes = mode === "renvoi" && codesShown && !!attached;
      bar(numbersEmpty ? "Réessayer" : codes ? "C’est fait" : "Continuer", null, msg ? "Continuer sans numéro" : null);
      onPrimary = numbersEmpty ? retryNumbers : codes ? () => go(4) : () => saveNumber(true);
    }
    function retryNumbers() {
      numbersEmpty = false;
      numbersLoaded = false;
      numberError(null);
      $("[data-numbers-status]").hidden = false;
      loadNumbers();
    }

    async function loadNumbers() {
      if (numbersLoaded) return;
      numbersLoaded = true;
      const status = $("[data-numbers-status]");
      const [mine, search] = await Promise.all([
        api<{ numbers: { e164: string }[] }>("GET", "/api/numbers"),
        api<{ details: { e164: string; locality: string | null; type: "local" | "mobile" }[]; owned: { e164: string }[] }>("GET", "/api/numbers/search?country=FR"),
      ]);
      type Choice = { e164: string; sub: string };
      const list: Choice[] = [];
      const seen = new Set<string>();
      const add = (e164: string, sub: string) => { if (!seen.has(e164)) { seen.add(e164); list.push({ e164, sub }); } };
      for (const n of mine.ok ? mine.data.numbers : []) add(n.e164, "Votre numéro actuel");
      if (search.ok) {
        for (const n of search.data.owned ?? []) add(n.e164, "Disponible tout de suite");
        for (const n of search.data.details ?? []) add(n.e164, [n.type === "mobile" ? "Portable" : "Fixe", n.locality].filter(Boolean).join(" · "));
      }
      status.hidden = true;
      if (!list.length) {
        numbersEmpty = true;
        numberError(search.ok
          ? "Aucun numéro disponible pour l’instant. Réessayez plus tard ou continuez sans numéro."
          : "Impossible d’afficher les numéros pour l’instant. Réessayez plus tard ou continuez sans numéro.");
        return;
      }
      if (!chosenNumber) chosenNumber = list[0].e164;
      numbersBox.replaceChildren(...list.map((n) => {
        const radio = el("input", { type: "radio", name: "number", value: n.e164, class: "radio" }) as HTMLInputElement;
        radio.checked = n.e164 === chosenNumber;
        radio.addEventListener("change", () => { chosenNumber = n.e164; });
        return el("label", { class: "row cursor-pointer" }, radio,
          el("span", { class: "flex flex-col" }, el("span", { class: "font-bold" }, frPhone(n.e164)), el("span", { class: "text-small text-muted" }, n.sub)));
      }));
      renderMode();
    }

    async function saveRouting(): Promise<boolean> {
      const phone = input("phone3").value.trim();
      if (!phone) { fieldHelp("phone3", "Indiquez votre portable : il sonne en premier.", true); input("phone3").focus(); return false; }
      const r = await api<{ business: Init["business"] }>("PUT", "/api/business", { artisan_phone: phone, ring_seconds: ring, forwarding_mode: mode });
      if (!r.ok) {
        if (/portable/i.test(r.data.hint ?? "")) { fieldHelp("phone3", "Ce numéro ne marche pas. Exemple : 06 12 34 56 78", true); input("phone3").focus(); }
        else showError(r.data.hint ?? "Enregistrement impossible. Réessayez.");
        return false;
      }
      fieldHelp("phone3", null);
      Object.assign(biz, r.data.business);
      return true;
    }

    async function saveNumber(withNumber: boolean) {
      showError(null);
      if (withNumber && !chosenNumber) { showError("Choisissez un numéro."); return; }
      busy(true, "Enregistrement…");
      if (!(await saveRouting())) { busy(false); numberError($("[data-numbers-error-text]").textContent || null); return; }
      if (withNumber && chosenNumber !== attached) {
        busy(true, "Mise en service du numéro…");
        const r = await api<{ number: { e164: string } }>("POST", "/api/numbers", { e164: chosenNumber });
        busy(false);
        if (!r.ok) {
          numberError(r.data.error === "number_taken"
            ? "Ce numéro est déjà pris. Choisissez-en un autre."
            : "Ce numéro n’a pas pu être mis en service. Réessayez ou continuez sans numéro.");
          return;
        }
        attached = r.data.number.e164;
        storedStep = "done";
      }
      busy(false);
      // Keeping his number: show the forwarding codes before the test step
      if (withNumber && mode === "renvoi" && attached) { codesShown = true; renderMode(); $("[data-codes]").scrollIntoView({ block: "start" }); return; }
      go(4);
    }

    // ---------- Step 4 · Essai ----------
    function enterTest() {
      $("[data-has-number]").hidden = !attached;
      $("[data-no-number]").hidden = !!attached;
      $("[data-ready]").hidden = !attached;
      // Keeping his number: the test is a call to his own mobile, left unanswered
      const renvoi = mode === "renvoi" && !!biz.artisan_phone;
      const testNumber = renvoi ? biz.artisan_phone! : attached;
      $("[data-test-label]").textContent = renvoi ? "Appelez votre portable pour l’essayer" : "Appelez ce numéro pour l’essayer";
      $("[data-test-help]").textContent = renvoi
        ? "Depuis un autre téléphone. Ne décrochez pas : le répondeur prend l’appel."
        : "Appelez depuis un autre téléphone que votre portable.";
      $("[data-give-title]").hidden = renvoi;
      $("[data-give]").hidden = renvoi;
      if (attached && testNumber) {
        $("[data-test-number]").textContent = frPhone(testNumber);
        $<HTMLAnchorElement>("[data-test-link]").href = `tel:${testNumber}`;
      }
      bar("Terminer", "check", null);
      onPrimary = async () => {
        busy(true, "Enregistrement…");
        const r = await api("PUT", "/api/business", { onboarding_step: "done" });
        if (!r.ok) { busy(false); bar("Terminer", "check", null); showError(r.data.hint ?? "Enregistrement impossible. Réessayez."); return; }
        location.href = "/app";
      };
    }

    // ---------- What each step does when it is shown ----------
    const enter: Record<number, () => void> = {
      1: () => { renderHours(); renderFaqs(); showPhase(phase === "site" ? "site" : "form"); },
      2: () => {
        // The first name may have changed on step 1: a generated greeting follows it
        syncGreeting();
        bar("Continuer", null, null);
        onPrimary = saveVoice;
        if (!voices) loadVoices(); else voiceBar();
      },
      3: () => {
        if (!input("phone3").value) input("phone3").value = frPhone(biz.artisan_phone);
        renderMode();
        numberError($("[data-numbers-error-text]").textContent || null);
        onSecondary = () => saveNumber(false);
        loadNumbers();
      },
      4: enterTest,
    };

    // Show stored phone numbers in French format, then open the resumed step
    input("phone1").value = frPhone(input("phone1").value);
    input("phone3").value = frPhone(input("phone3").value);
    history.replaceState({ step: init.step }, "", `?etape=${init.step}`);
    go(init.step, false);
  </script>
</Base>

<style is:global>
  /* Indeterminate bar under « Lecture de votre site… » */
  .scan-bar { position: relative; height: 6px; overflow: hidden; border-radius: 3px; background: var(--color-line); }
  .scan-bar span { position: absolute; inset: 0 auto 0 0; width: 40%; border-radius: 3px; background: var(--color-ink); animation: scan-slide 1.4s ease-in-out infinite; }
  @keyframes scan-slide { from { transform: translateX(-100%); } to { transform: translateX(250%); } }
  @media (prefers-reduced-motion: reduce) { .scan-bar span { animation: none; width: 100%; opacity: .3; } }

  /* 48 px square icon button (add, remove, ring duration) */
  .step-btn { flex: none; display: grid; place-items: center; width: 48px; height: 48px; margin: -6px -8px -6px 0; border-radius: var(--radius-call); color: var(--color-ink); }
  /* Record button of « Utiliser ma voix »: 72 px, ink; while recording it turns white with a stop square */
  .rec-btn { display: grid; place-items: center; width: 72px; height: 72px; border-radius: 50%; color: #fff; background: var(--color-ink); box-shadow: inset 0 0 0 1px var(--color-ink); transition: background 150ms, color 150ms; }
  .rec-btn.is-recording { color: var(--color-ink); background: var(--color-surface); box-shadow: inset 0 0 0 2px var(--color-ink); }
  .rec-btn:focus-visible, .link-btn:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
  /* Text button inside a block row (« Enregistrer à nouveau ») */
  .link-btn { min-height: 48px; padding: 0 4px; font-size: var(--text-small); font-weight: 700; color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }

  /* Consent checkbox: 22 px square in ink, check mark when ticked */
  .checkbox { appearance: none; flex: none; width: 22px; height: 22px; border-radius: 4px; box-shadow: inset 0 0 0 2px var(--color-ink); display: grid; place-items: center; }
  .checkbox:checked { background: var(--color-ink); }
  .checkbox:checked::after { content: ""; width: 6px; height: 11px; margin-top: -3px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .checkbox:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }

  .step-btn:focus-visible, .play-btn:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }

  /* Listen button: same look as the call button of the list (DESIGN.md « Bouton d'appel en liste ») */
  .play-btn { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--radius-call); color: var(--color-action-ink); background: var(--color-tint); box-shadow: inset 0 0 0 1px var(--color-tint-line); }

  /* Time slot input, filled like a Material field */
  .time-input { width: 108px; height: 44px; padding: 0 10px; border-radius: 4px 4px 0 0; background: var(--color-neutral-bg); box-shadow: inset 0 -1px 0 var(--color-muted); font-size: var(--text-body); color: var(--color-ink); }
  .time-input:focus { outline: none; box-shadow: inset 0 -2px 0 var(--color-ink); }

  /* Question / answer edited in place inside a block row */
  .faq-text { width: 100%; resize: none; field-sizing: content; min-height: 24px; padding: 2px 4px; margin: 0 -4px; border-radius: 4px; background: transparent; line-height: 1.35; }
  .faq-text:focus { outline: none; background: var(--color-neutral-bg); color: var(--color-ink); }

  /* Radio: 22 px ring in ink, filled dot when chosen */
  .radio { appearance: none; flex: none; width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 2px var(--color-ink); display: grid; place-items: center; }
  .radio::after { content: ""; width: 12px; height: 12px; border-radius: 50%; background: var(--color-ink); transform: scale(0); transition: transform 120ms; }
  .radio:checked::after { transform: scale(1); }
  .radio:focus-visible { outline: 2px solid var(--color-ink); outline-offset: 2px; }
</style>
