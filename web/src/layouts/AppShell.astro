---
// Logged-in app frame. On a computer (≥ 1024 px): left sidebar with the brand and the menu.
// On a phone: only the page content, exactly as before (DESIGN.md « Espace et mise en page »).
import Base from "./Base.astro";
import Icon from "../components/Icon.astro";
import { urgentToCallBackCount } from "../lib/leads-list";

type Section = "appels" | "agenda" | "visibilite" | "google" | "reseaux" | "pubs" | "reglages";
interface Props { title: string; active: Section; urgent?: number }
const { title, active } = Astro.props;
const { business } = Astro.locals;
const urgent = Astro.props.urgent ?? (business ? await urgentToCallBackCount(business.id) : 0);


const nav: { id: Section; href: string; label: string; icon: "phone" | "calendar" | "globe" | "settings" | "store" | "share" | "megaphone" }[] = [
  { id: "appels", href: "/app", label: "Appels", icon: "phone" },
  { id: "agenda", href: "/app/agenda", label: "Agenda", icon: "calendar" },
  { id: "visibilite", href: "/app/visibilite", label: "Site web", icon: "globe" },
  { id: "google", href: "/app/google", label: "Fiche Google", icon: "store" },
  { id: "reseaux", href: "/app/reseaux", label: "Réseaux sociaux", icon: "share" },
  { id: "pubs", href: "/app/publicites", label: "Publicités", icon: "megaphone" },
  { id: "reglages", href: "/app/reglages", label: "Réglages", icon: "settings" },
];
const item = "flex min-h-12 items-center gap-3 rounded-call px-3 font-bold";
---
<Base title={title}>
  <!-- Phone (< 1024 px): a top bar with the menu button; the menu opens as a panel from the left -->
  <header class="sticky top-0 z-30 flex h-14 items-center gap-2 border-b border-line bg-page px-2 lg:hidden">
    <button type="button" class="grid size-12 place-items-center rounded-call text-ink" aria-label="Ouvrir le menu" aria-controls="app-menu" aria-expanded="false" data-menu-open><Icon name="menu" /></button>
    <a href="/app" class="flex items-center gap-2 text-[17px] font-bold">
      <span class="grid size-[30px] place-items-center rounded-filter bg-action text-ink shadow-[inset_0_0_0_1px_var(--color-action-line)]"><Icon name="phone" size={16} /></span>
      Répondeur
    </a>
    {urgent > 0 && <a href="/app" class="chip chip-urgence ml-auto mr-2 self-center" aria-label={`${urgent} urgence${urgent > 1 ? "s" : ""} à rappeler`}>{urgent}</a>}
  </header>
  <div id="app-menu" class="fixed inset-0 z-40 lg:hidden" hidden>
    <div class="absolute inset-0 bg-scrim" data-menu-close></div>
    <aside class="absolute inset-y-0 left-0 flex w-[280px] max-w-[85vw] flex-col gap-1 border-r border-line bg-surface px-4 py-4" aria-label="Menu">
      <div class="mb-4 flex items-center justify-between">
        <a href="/app" class="flex items-center gap-3 px-1 text-[17px] font-bold">
          <span class="grid size-[34px] place-items-center rounded-filter bg-action text-ink shadow-[inset_0_0_0_1px_var(--color-action-line)]"><Icon name="phone" size={18} /></span>
          Répondeur
        </a>
        <button type="button" class="grid size-12 place-items-center rounded-call text-ink" aria-label="Fermer le menu" data-menu-close><Icon name="x" /></button>
      </div>
      <nav class="flex flex-col gap-1">
        {nav.map((n) => (
          <a href={n.href} aria-current={n.id === active ? "page" : undefined}
             class={`${item} ${n.id === active ? "bg-page text-ink shadow-[inset_0_0_0_1px_var(--color-line)]" : "text-muted"}`}>
            <Icon name={n.icon} />
            {n.label}
            {n.id === "appels" && urgent > 0 && <span class="chip chip-urgence ml-auto self-center">{urgent}</span>}
          </a>
        ))}
      </nav>
      <form method="post" action="/api/auth/logout" class="mt-auto">
        <button class={`${item} w-full text-muted`}><Icon name="log-out" />Se déconnecter</button>
      </form>
    </aside>
  </div>
  <!-- The sidebar column is painted on the wrapper too, so its white goes down the whole page on long pages -->
  <div class="lg:flex lg:min-h-dvh lg:bg-[linear-gradient(to_right,var(--color-surface)_239px,var(--color-line)_239px,var(--color-line)_240px,transparent_240px)]">
    <aside class="sticky top-0 hidden h-dvh w-[240px] shrink-0 flex-col gap-1 border-r border-line bg-surface px-4 py-6 lg:flex">
      <a href="/app" class="mb-6 flex items-center gap-3 px-1 text-[17px] font-bold">
        <span class="grid size-[34px] place-items-center rounded-filter bg-action text-ink shadow-[inset_0_0_0_1px_var(--color-action-line)]"><Icon name="phone" size={18} /></span>
        Répondeur
      </a>
      <nav class="flex flex-col gap-1" aria-label="Menu">
        {nav.map((n) => (
          <a href={n.href} aria-current={n.id === active ? "page" : undefined}
             class={`${item} ${n.id === active ? "bg-page text-ink shadow-[inset_0_0_0_1px_var(--color-line)]" : "text-muted hover:text-ink"}`}>
            <Icon name={n.icon} />
            {n.label}
            {n.id === "appels" && urgent > 0 && <span class="chip chip-urgence ml-auto self-center" aria-label={`${urgent} urgence${urgent > 1 ? "s" : ""} à rappeler`}>{urgent}</span>}
          </a>
        ))}
      </nav>
      <form method="post" action="/api/auth/logout" class="mt-auto">
        <button class={`${item} w-full text-muted hover:text-ink`}><Icon name="log-out" />Se déconnecter</button>
      </form>
    </aside>
    <div class="min-w-0 flex-1">
      <slot />
    </div>
  </div>
</Base>

<script>
  // Phone menu: open from the top bar, close on the scrim, the cross, Escape or a link
  const menu = document.getElementById("app-menu");
  const opener = document.querySelector<HTMLButtonElement>("[data-menu-open]");
  const setOpen = (open: boolean) => {
    if (!menu || !opener) return;
    menu.hidden = !open;
    opener.setAttribute("aria-expanded", String(open));
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) menu.querySelector<HTMLElement>("nav a")?.focus(); else opener.focus();
  };
  opener?.addEventListener("click", () => setOpen(true));
  menu?.querySelectorAll("[data-menu-close]").forEach((el) => el.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && menu && !menu.hidden) setOpen(false); });
</script>
