---
// Realistic Google search result for the ad: « Sponsorisé », advertiser, link, headlines, descriptions, call button.
// Uses Google's own colours on purpose: it is a picture of the Google page, not an app surface.
import HubIcon from "../hub/HubIcon.astro";
import type { GoogleDraft } from "../../lib/ads";
interface Props { draft: GoogleDraft; name: string; phone: string | null; siteUrl: string | null }
const { draft, name, phone, siteUrl } = Astro.props;
const shownUrl = siteUrl ? siteUrl.replace(/^https?:\/\//, "").replace(/\//g, " › ") : null;
const initial = (name.trim()[0] ?? "A").toUpperCase();
---
<div class="gad" aria-label="Aperçu de l’annonce sur Google">
  <p class="gad-sponsor">Sponsorisé</p>
  <div class="flex items-center gap-2.5">
    <span class="gad-fav" aria-hidden="true">{initial}</span>
    <div class="min-w-0">
      <p class="gad-name truncate">{name || "Votre entreprise"}</p>
      <p class="gad-url truncate">{shownUrl ?? (phone ? `Appel · ${phone}` : "Appel")}</p>
    </div>
  </div>
  <p class="gad-title">{draft.headlines.join(" | ")}</p>
  <p class="gad-desc">{draft.descriptions.join(" ")}</p>
  {phone && <p class="gad-call"><HubIcon name="phone" size={16} />{phone}</p>}
</div>

<style>
  .gad { font-family: Arial, Helvetica, sans-serif; background: #fff; border-radius: 12px; box-shadow: inset 0 0 0 1px var(--color-line); padding: 14px; color: #202124; }
  .gad-sponsor { font-size: 14px; font-weight: 700; margin-bottom: 8px; }
  .gad-fav { width: 28px; height: 28px; flex: none; display: grid; place-items: center; border-radius: 999px; background: #f1f3f4; box-shadow: inset 0 0 0 1px #dadce0; font-size: 14px; font-weight: 700; color: #202124; }
  .gad-name { font-size: 14px; line-height: 1.3; }
  .gad-url { font-size: 12px; line-height: 1.3; color: #4d5156; }
  .gad-title { margin-top: 8px; font-size: 17px; line-height: 1.3; color: #1a0dab; }
  .gad-desc { margin-top: 4px; font-size: 14px; line-height: 1.45; color: #4d5156; }
  .gad-call { margin-top: 10px; display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border-radius: 999px; box-shadow: inset 0 0 0 1px #dadce0; font-size: 14px; color: #1a0dab; }
</style>
