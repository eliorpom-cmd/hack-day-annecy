---
// Picture of a Google Maps search (« plombier annecy ») with the artisan's ad on top of the list and
// its pin on the map. The other results are invented. Uses Google's own look on purpose: it is a
// picture of the Google page, not an app surface (same rule as GooglePreview).
interface Props { name: string; trade: string; city: string; phone: string | null; siteUrl: string | null }
const { name, trade, city, phone, siteUrl } = Astro.props;
const tradeLow = trade.trim().toLowerCase() || "artisan";
const tradeCap = tradeLow.charAt(0).toUpperCase() + tradeLow.slice(1);
const town = city.trim() || "votre ville";
const query = `${tradeLow} ${town.toLowerCase()}`;
const others = [
  { name: `${tradeCap} du Lac`, rating: "4,2", stars: 4, count: 116, hours: "Ouvre à 8 h" },
  { name: `${town} Dépannage Services`, rating: "3,6", stars: 4, count: 582, hours: "Ouvre à 9 h" },
];
// Pins of the other results: [x, y] in the 400 × 300 map
const pins = [[92, 70], [300, 58], [262, 196], [120, 214], [328, 120], [60, 150]];
---
<div class="gm" aria-label={`Aperçu d’une recherche « ${query} » sur Google Maps`}>
  <div class="gm-list">
    <div class="gm-search">
      <span class="truncate">{query}</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5f6368" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
    </div>
    <p class="gm-results">Résultats</p>

    <article class="gm-item gm-ad">
      <p class="gm-name">{name || "Votre entreprise"}</p>
      <p class="gm-meta"><b class="gm-sponsor">Sponsorisé</b> · {tradeCap} · {town}</p>
      <p class="gm-meta"><span class="gm-open">Ouvert</span> · Répond 24 h/24{phone && ` · ${phone}`}</p>
      <div class="gm-actions">
        <span class="gm-btn gm-btn-call">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
          Appeler
        </span>
        <span class="gm-btn">Itinéraire</span>
        {siteUrl && <span class="gm-btn">Site web</span>}
      </div>
    </article>

    {others.map((o) => (
      <article class="gm-item">
        <p class="gm-name">{o.name}</p>
        <p class="gm-meta">
          {o.rating} <span class="gm-stars" aria-hidden="true">{"★".repeat(o.stars)}<span class="gm-star-off">{"★".repeat(5 - o.stars)}</span></span> ({o.count})
        </p>
        <p class="gm-meta">{tradeCap} · {town}</p>
        <p class="gm-meta"><span class="gm-closed">Fermé</span> · {o.hours}</p>
      </article>
    ))}
  </div>

  <div class="gm-map" aria-hidden="true">
    <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 size-full">
      <rect width="400" height="300" fill="#eef2ea" />
      <path d="M0 40 C80 60 120 30 210 70 S330 40 400 70 V0 H0 Z" fill="#d7ecd2" />
      <path d="M0 255 C70 230 130 270 200 250 S290 290 300 300 H0 Z" fill="#d7ecd2" />
      <path d="M300 140 C340 130 360 160 400 150 V300 H285 C300 260 270 220 290 190 C300 170 285 150 300 140 Z" fill="#a8d4f7" />
      <g fill="none" stroke="#fff" stroke-linecap="round">
        <path d="M0 120 C100 110 160 150 260 140 S360 110 400 110" stroke-width="7" />
        <path d="M150 0 C160 80 140 160 175 300" stroke-width="7" />
        <path d="M40 300 C90 220 150 190 220 170 S300 90 340 0" stroke-width="5" />
        <path d="M0 200 C80 190 140 220 230 230" stroke-width="4" />
        <path d="M230 0 C220 60 250 100 240 170" stroke-width="4" />
      </g>
      <g fill="none" stroke="#f7d774" stroke-linecap="round"><path d="M0 120 C100 110 160 150 260 140 S360 110 400 110" stroke-width="2.5" /></g>
      <text x="196" y="182" class="gm-town">{town.toUpperCase()}</text>
      {pins.map(([x, y]) => (
        <g transform={`translate(${x} ${y})`}>
          <path d="M0 0 C-7 -9 -9 -13 -9 -17 A9 9 0 1 1 9 -17 C9 -13 7 -9 0 0 Z" fill="#ea4335" stroke="#b31412" stroke-width="1" />
          <circle cy="-17" r="3.2" fill="#b31412" />
        </g>
      ))}
    </svg>
    <div class="gm-you">
      <span class="gm-you-label">{name || "Votre entreprise"}</span>
      <svg width="34" height="44" viewBox="-12 -32 24 33"><path d="M0 0 C-9 -12 -12 -17 -12 -21 A12 12 0 1 1 12 -21 C12 -17 9 -12 0 0 Z" fill="#0b2545" stroke="#fff" stroke-width="1.5" /><circle cy="-21" r="4.5" fill="#4ee494" /></svg>
    </div>
  </div>
</div>

<style>
  .gm { font-family: Arial, Helvetica, sans-serif; color: #202124; background: #fff; border-radius: 12px; overflow: hidden; box-shadow: inset 0 0 0 1px var(--color-line); display: flex; flex-direction: column-reverse; }
  .gm-list { display: flex; flex-direction: column; padding: 12px 0 4px; }
  .gm-search { margin: 0 12px 10px; display: flex; align-items: center; justify-content: space-between; gap: 8px; height: 44px; padding: 0 14px 0 18px; border-radius: 999px; box-shadow: 0 0 0 1px #dadce0; font-size: 16px; }
  .gm-results { padding: 2px 16px 6px; font-size: 18px; }
  .gm-item { padding: 10px 16px 12px; border-top: 1px solid #e8eaed; }
  .gm-ad { background: #f8fbff; }
  .gm-name { font-size: 16px; font-weight: 700; line-height: 1.3; }
  .gm-meta { font-size: 14px; line-height: 1.45; color: #4d5156; }
  .gm-sponsor { color: #202124; }
  .gm-stars { color: #fbbc04; letter-spacing: 1px; }
  .gm-star-off { color: #dadce0; }
  .gm-open { color: #188038; }
  .gm-closed { color: #d93025; }
  .gm-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .gm-btn { display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 14px; border-radius: 999px; font-size: 14px; color: #0b57d0; box-shadow: inset 0 0 0 1px #c4c7c5; }
  .gm-btn-call { color: #fff; background: #0b57d0; box-shadow: none; }
  .gm-map { position: relative; height: 200px; overflow: hidden; }
  .gm-town { font: 700 13px Arial, sans-serif; letter-spacing: 2px; fill: #5f6368; text-anchor: middle; }
  .gm-you { position: absolute; left: 50%; top: 32%; transform: translate(-50%, -100%); display: flex; flex-direction: column; align-items: center; }
  .gm-you-label { margin-bottom: 2px; padding: 3px 8px; border-radius: 6px; background: #fff; font-size: 13px; font-weight: 700; white-space: nowrap; box-shadow: 0 0 0 1px #dadce0; }
  @media (min-width: 1024px) {
    .gm { flex-direction: row; min-height: 420px; }
    .gm-list { width: 340px; flex: none; border-right: 1px solid #e8eaed; }
    .gm-map { height: auto; flex: 1; }
  }
</style>
