---
// Realistic Facebook / Instagram feed ad: page, « Sponsorisé », text, photo slot, headline bar with « Appeler ».
// Facebook's own colours on purpose (picture of the feed). No image in the app: the photo slot stays neutral.
import HubIcon from "../hub/HubIcon.astro";
import type { MetaDraft } from "../../lib/ads";
interface Props { draft: MetaDraft; name: string; phone: string | null }
const { draft, name, phone } = Astro.props;
const initial = (name.trim()[0] ?? "A").toUpperCase();
---
<div class="mad" aria-label="Aperçu de l’annonce sur Facebook et Instagram">
  <div class="flex items-center gap-2.5 px-3 pt-3">
    <span class="mad-avatar" aria-hidden="true">{initial}</span>
    <div class="min-w-0">
      <p class="mad-name truncate">{name || "Votre entreprise"}</p>
      <p class="mad-meta">Sponsorisé · <HubIcon name="globe" size={12} /></p>
    </div>
  </div>
  <p class="mad-text px-3 pt-2 pb-3">{draft.primaryText}</p>
  <div class="mad-photo"><span>Une photo de vos chantiers</span></div>
  <div class="mad-bar">
    <div class="min-w-0 flex-1">
      <p class="mad-small truncate">{phone ?? "Appel"}</p>
      <p class="mad-headline">{draft.headline}</p>
    </div>
    <span class="mad-cta"><HubIcon name="phone" size={16} />{draft.cta}</span>
  </div>
</div>

<style>
  .mad { font-family: Helvetica, Arial, sans-serif; background: #fff; border-radius: 12px; box-shadow: inset 0 0 0 1px var(--color-line); overflow: hidden; color: #050505; }
  .mad-avatar { width: 36px; height: 36px; flex: none; display: grid; place-items: center; border-radius: 999px; background: var(--color-ink); color: #fff; font-weight: 700; font-size: 14px; }
  .mad-name { font-size: 14px; font-weight: 700; line-height: 1.3; }
  .mad-meta { display: flex; align-items: center; gap: 4px; font-size: 12px; color: #65676b; }
  .mad-text { font-size: 14px; line-height: 1.4; }
  .mad-photo { aspect-ratio: 1.91 / 1; display: grid; place-items: center; background: var(--color-neutral-bg); border-block: 1px solid var(--color-neutral-line); color: var(--color-muted); font-size: 14px; }
  .mad-bar { display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: #f0f2f5; }
  .mad-small { font-size: 12px; color: #65676b; text-transform: uppercase; }
  .mad-headline { font-size: 14px; font-weight: 700; line-height: 1.3; }
  .mad-cta { flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 6px; background: #e4e6eb; font-size: 14px; font-weight: 700; }
</style>
