---
// A « Visibilité » channel that is available: icon, label, one line, chevron. The whole row is the link (≥ 48 px).
import HubIcon, { type HubIconName } from "./HubIcon.astro";
interface Props { href: string; icon: HubIconName; label: string; line: string }
const { href, icon, label, line } = Astro.props;
---
<li>
  <a href={href} class="row items-start hub-link">
    <span class="icon-tile"><HubIcon name={icon} size={18} class="text-ink" /></span>
    <span class="flex min-w-0 flex-1 flex-col"><span class="font-bold">{label}</span><span class="mt-0.5 text-small text-muted">{line}</span></span>
    <svg class="mt-1 flex-none text-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
  </a>
</li>

<style is:global>
  li + li > .hub-link { border-top: 1px solid var(--color-line); }
  .hub-link:focus-visible { outline: 2px solid var(--color-ink); outline-offset: -2px; border-radius: var(--radius-block); }
</style>
