---
// « Visibilité » : the hub. Only the generated website exists today; the rest is marked « Bientôt ».
import Icon from "../Icon.astro";
import Glyph from "./Glyph.astro";

const items = [
  { icon: "globe", name: "Site web", text: "Créé à partir de votre configuration, avec votre numéro de répondeur.", soon: false },
  { icon: "pin", name: "Fiche Google", text: "Vos horaires et votre numéro à jour sur Google Maps.", soon: true },
  { icon: "share", name: "Réseaux sociaux", text: "Vos chantiers terminés publiés sur Facebook et Instagram.", soon: true },
  { icon: "megaphone", name: "Publicités", text: "Des annonces Google et Facebook autour de chez vous.", soon: true },
] as const;
---
<section id="visibilite" class="l-section scroll-mt-4 bg-surface">
  <div class="l-wrap grid gap-14 lg:grid-cols-[1fr_1.05fr] lg:items-center lg:gap-20">
    <div>
      <h2 class="l-h2" data-reveal>Plus de clients, et quelqu’un pour leur répondre</h2>
      <p class="l-lead mt-5" data-reveal>Une publicité ne sert à rien si personne ne décroche. Le répondeur d’abord, puis tout ce qui fait sonner votre téléphone.</p>
      <ul class="panel mt-10" data-reveal>
        {items.map((it) => (
          <li class="row items-start py-4">
            <span class="icon-tile mt-[2px]">
              {it.icon === "share" || it.icon === "megaphone" ? <Glyph name={it.icon} size={18} /> : <Icon name={it.icon} size={18} />}
            </span>
            <div class="flex-1">
              <p class="flex flex-wrap items-center gap-2 font-bold">{it.name}
                <span class:list={["chip", it.soon ? "chip-soon" : "chip-ready"]}>{it.soon ? "Bientôt" : "Disponible"}</span>
              </p>
              <p class="mt-1 text-small text-muted">{it.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="overflow-hidden rounded-dialog bg-page shadow-[inset_0_0_0_1px_var(--color-line)]" data-reveal role="img" aria-label="Le site web généré pour Plomberie Martin, avec le numéro du répondeur.">
      <div class="flex items-center gap-3 border-b border-line bg-surface px-5 py-3" aria-hidden="true">
        <span class="flex gap-[6px]"><i class="size-3 rounded-full bg-line"></i><i class="size-3 rounded-full bg-line"></i><i class="size-3 rounded-full bg-line"></i></span>
        <span class="flex-1 rounded-filter bg-neutral-bg px-3 py-1 text-center text-small text-muted">plomberie-martin.fr</span>
      </div>
      <div class="p-6 sm:p-10" aria-hidden="true">
        <p class="text-small font-bold text-muted">Plombier à Annecy</p>
        <p class="mt-2 text-[34px] font-bold leading-[1.05] tracking-[-0.02em] sm:text-[44px]">Plomberie Martin</p>
        <p class="mt-3 text-muted">Dépannage, salle de bain et chauffe-eau, du lundi au samedi.</p>
        <span class="btn btn-primary mt-6 w-full sm:w-auto sm:px-7"><Icon name="phone" />Appeler le 04 50 12 34 56</span>
        <ul class="panel mt-8">
          <li class="row"><span class="icon-tile"><Icon name="alert" size={18} /></span><span class="flex-1">Fuite et dépannage urgent</span></li>
          <li class="row"><span class="icon-tile"><Icon name="briefcase" size={18} /></span><span class="flex-1">Rénovation de salle de bain</span></li>
          <li class="row"><span class="icon-tile"><Icon name="clock" size={18} /></span><span class="flex-1">Lundi au samedi, 8 h à 18 h</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .chip-ready { color: var(--color-action-ink); background: var(--color-tint); box-shadow: inset 0 0 0 1px var(--color-tint-line); }
  .chip-soon { color: var(--color-neutral); background: var(--color-neutral-bg); box-shadow: inset 0 0 0 1px var(--color-neutral-line); }
</style>
